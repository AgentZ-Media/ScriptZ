---
/**
 * `/vergleich` (DE). PageHero (compact) + VERGLEICH-Section.
 */
import Base from "../layouts/Base.astro";
import AppShell from "../components/AppShell.astro";
import PageHero from "../components/sections/PageHero.astro";
import VergleichSection from "../components/sections/VergleichSection.astro";
import { t } from "../i18n";

const lang = "de" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.compare.title")}
  description={t(lang, "meta.compare.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.vergleich.keyword")}
    subline={t(lang, "hero.vergleich.subline")}
  >
    {t(lang, "hero.vergleich.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="vergleich">
    <VergleichSection lang={lang} />
  </AppShell>
</Base>
