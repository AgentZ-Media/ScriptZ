---
import Base from "../layouts/Base.astro";
import LegalShell from "../components/LegalShell.astro";
import { site } from "../data/site";
---

<Base
  pageTitle="Impressum"
  description={`Anbieterkennzeichnung gemäß § 5 DDG für ${site.domain}.`}
>
  <LegalShell
    activeTab="impressum"
    title="Impressum"
    subtitle="Angaben gemäß § 5 DDG (Digitale-Dienste-Gesetz)."
  >
    <div class="v2-block v2-caption">INT. IMPRESSUM — § 5 DDG</div>

    <div class="v2-block v2-action">
      <strong>Diensteanbieter</strong>
    </div>
    <p class="v2-block v2-action v2-address">
      AgentZ Media<br />
      Inhaber: Axel Roller<br />
      Ziegenmarkt 6<br />
      19055 Schwerin<br />
      Deutschland
    </p>

    <div class="v2-block v2-action">
      <strong>Kontakt</strong>
    </div>
    <p class="v2-block v2-action v2-address">
      Telefon: <a href="tel:+4938557568044">+49 385 5756 8044</a><br />
      E-Mail: <a href={`mailto:${site.contactEmail}`}>E-Mail schreiben</a>
    </p>

    <div class="v2-block v2-action">
      <strong>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</strong>
    </div>
    <p class="v2-block v2-action v2-address">
      Axel Roller<br />
      Ziegenmarkt 6, 19055 Schwerin
    </p>

    <div class="v2-block v2-action">
      <strong>Zuständige Kammer</strong>
    </div>
    <p class="v2-block v2-action v2-address">
      Industrie- und Handelskammer zu Schwerin<br />
      Graf-Schack-Allee 12, 19053 Schwerin
    </p>

    <div class="v2-block v2-caption">EXT. STREITBEILEGUNG</div>

    <div class="v2-block v2-action">
      <strong>Online-Streitbeilegung (OS)</strong>
    </div>
    <p class="v2-block v2-action">
      Die Europäische Kommission stellt eine Plattform zur
      Online-Streitbeilegung bereit:
      <a
        href="https://ec.europa.eu/consumers/odr/"
        target="_blank"
        rel="noopener noreferrer">https://ec.europa.eu/consumers/odr/</a
      >.
    </p>

    <div class="v2-block v2-action">
      <strong>Verbraucherstreitbeilegung</strong>
    </div>
    <p class="v2-block v2-action">
      Wir sind nicht bereit und nicht verpflichtet, an
      Streitbeilegungsverfahren vor einer
      Verbraucherschlichtungsstelle teilzunehmen.
    </p>

    <div class="v2-block v2-camera">FADE OUT.</div>
  </LegalShell>
</Base>
