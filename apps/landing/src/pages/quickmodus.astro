---
/**
 * `/quickmodus` (DE). PageHero (compact) + QUICKMODUS section.
 */
import Base from "../layouts/Base.astro";
import AppShell from "../components/AppShell.astro";
import PageHero from "../components/sections/PageHero.astro";
import QuickmodusSection from "../components/sections/QuickmodusSection.astro";
import { t } from "../i18n";

const lang = "de" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.quickmodus.title")}
  description={t(lang, "meta.quickmodus.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.quickmodus.keyword")}
    subline={t(lang, "hero.quickmodus.subline")}
  >
    {t(lang, "hero.quickmodus.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="quickmodus">
    <QuickmodusSection lang={lang} />
  </AppShell>
</Base>
