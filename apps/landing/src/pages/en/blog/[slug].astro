---
/**
 * `/en/blog/<slug>` - Blog post detail (English). Mirror of `/blog/<slug>`.
 */
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import BlogPost from "../../../components/blog/BlogPost.astro";
import {
  getPosts,
  hasTranslation,
  parseEntryId,
  postPath,
  blogIndexPath,
} from "../../../lib/blog";
import { type Lang } from "../../../i18n";

export async function getStaticPaths() {
  const posts = await getPosts("en");
  return posts.map((entry) => {
    const parsed = parseEntryId(entry.id)!;
    return {
      params: { slug: parsed.slug },
      props: { entry },
    };
  });
}

const lang: Lang = "en";
const { entry } = Astro.props;
const slug = parseEntryId(entry.id)!.slug;

const hasOther = await hasTranslation(slug, "de");
const switchHref = hasOther ? postPath(slug, "de") : blogIndexPath("de");
---

<Base
  title={`${entry.data.title} - ScriptZ Blog`}
  description={entry.data.description}
  lang={lang}
>
  <AppShell
    lang={lang}
    activeTab="blog"
    toolbarTitleOverride={entry.data.title}
    switchLangHrefOverride={switchHref}
  >
    <BlogPost entry={entry} lang={lang} />
  </AppShell>
</Base>
