---
/**
 * `/en/blog` - Blog overview (English). Mirror of `/blog`.
 */
import Base from "../../../layouts/Base.astro";
import AppShell from "../../../components/AppShell.astro";
import BlogIndex from "../../../components/blog/BlogIndex.astro";
import { t } from "../../../i18n";

const lang = "en" as const;
---

<Base
  title={t(lang, "meta.blog.title")}
  description={t(lang, "meta.blog.description")}
  lang={lang}
>
  <AppShell
    lang={lang}
    activeTab="blog"
    toolbarTitleOverride={t(lang, "blog.toolbar.title.index")}
  >
    <BlogIndex lang={lang} />
  </AppShell>
</Base>
