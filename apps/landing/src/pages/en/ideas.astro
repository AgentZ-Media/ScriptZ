---
/**
 * `/en/ideas`. PageHero (compact) + IDEEN-Section.
 */
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import PageHero from "../../components/sections/PageHero.astro";
import IdeenSection from "../../components/sections/IdeenSection.astro";
import { t } from "../../i18n";

const lang = "en" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.ideas.title")}
  description={t(lang, "meta.ideas.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.ideen.keyword")}
    subline={t(lang, "hero.ideen.subline")}
  >
    {t(lang, "hero.ideen.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="ideen">
    <IdeenSection lang={lang} />
  </AppShell>
</Base>
