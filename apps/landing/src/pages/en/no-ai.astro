---
/**
 * `/en/no-ai`. PageHero (compact) + NO-AI section.
 */
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import PageHero from "../../components/sections/PageHero.astro";
import NoAiSection from "../../components/sections/NoAiSection.astro";
import { t } from "../../i18n";

const lang = "en" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.noai.title")}
  description={t(lang, "meta.noai.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.noai.keyword")}
    subline={t(lang, "hero.noai.subline")}
  >
    {t(lang, "hero.noai.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="no-ai">
    <NoAiSection lang={lang} />
  </AppShell>
</Base>
