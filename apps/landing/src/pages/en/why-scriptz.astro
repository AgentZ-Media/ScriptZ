---
/**
 * `/en/why-scriptz`. PageHero (compact) + WarumSection.
 */
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import PageHero from "../../components/sections/PageHero.astro";
import WarumSection from "../../components/sections/WarumSection.astro";
import { t } from "../../i18n";

const lang = "en" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.warum.title")}
  description={t(lang, "meta.warum.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.warum.keyword")}
    subline={t(lang, "hero.warum.subline")}
  >
    {t(lang, "hero.warum.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="warum">
    <WarumSection lang={lang} />
  </AppShell>
</Base>
