---
/**
 * `/en/download`. PageHero (compact) + DOWNLOAD-Section.
 */
import Base from "../../layouts/Base.astro";
import AppShell from "../../components/AppShell.astro";
import PageHero from "../../components/sections/PageHero.astro";
import DownloadSection from "../../components/sections/DownloadSection.astro";
import { t } from "../../i18n";

const lang = "en" as const;
---
<Base
  lang={lang}
  title={t(lang, "meta.download.title")}
  description={t(lang, "meta.download.description")}
>
  <PageHero
    lang={lang}
    variant="compact"
    eyebrow={t(lang, "hero.download.keyword")}
    subline={t(lang, "hero.download.subline")}
  >
    {t(lang, "hero.download.title")}
  </PageHero>
  <AppShell lang={lang} activeTab="download">
    <DownloadSection lang={lang} />
  </AppShell>
</Base>
