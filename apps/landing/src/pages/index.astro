  <script is:inline>
    (function () {
      // ===== Reaktive Tabs ==========================================
      // Jeder Knopf mit data-tab schaltet die Sichtbarkeit der
      // .v2-tab-content-Sektion mit passendem data-content.
      // data-tab="home" ist Sonderfall: scrollt zurueck zum Hero.
      const tabs = document.querySelectorAll('[data-tab]');
      const contents = document.querySelectorAll('.v2-tab-content');
      const toolbarTitle = document.getElementById('toolbar-title');

      const activate = (id, opts) => {
        opts = opts || {};
        if (id === 'home') {
          // Home scrollt zum Hero, aber laesst den aktiven Tab in Ruhe.
          document.documentElement.scrollIntoView({ behavior: 'smooth' });
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        let activeTab = null;
        document.querySelectorAll('.v2-titlebar [data-tab]').forEach((b) => {
          const on = b.getAttribute('data-tab') === id;
          b.classList.toggle('is-active', on);
          if (on) activeTab = b;
        });

        contents.forEach((c) => {
          c.classList.toggle('is-active', c.getAttribute('data-content') === id);
        });

        if (activeTab && toolbarTitle) {
          const title = activeTab.getAttribute('data-title');
          if (title) toolbarTitle.textContent = title;
        }

        if (opts.scroll !== false) {
          // Scroll-Position so anpassen, dass die App-Chrome oben sichtbar
          // bleibt. Wir scrollen zum oberen Rand der Chrome.
          const chrome = document.querySelector('.v2-chrome');
          if (chrome) {
            const rect = chrome.getBoundingClientRect();
            const top = window.scrollY + rect.top;
            window.scrollTo({ top, behavior: 'smooth' });
          }
        }
      };

      tabs.forEach((t) => {
        t.addEventListener('click', () => {
          const id = t.getAttribute('data-tab');
          if (id) activate(id);
        });
      });

      // ===== Screenshot-Galerie =====================================
      const shotTabs = document.querySelectorAll('.v2-shot-tab');
      const shots = document.querySelectorAll('.v2-shot');
      shotTabs.forEach((t) => {
        t.addEventListener('click', () => {
          const id = t.getAttribute('data-shot');
          shotTabs.forEach((x) => {
            const on = x === t;
            x.classList.toggle('is-active', on);
            x.setAttribute('aria-selected', String(on));
          });
          shots.forEach((s) => {
            s.classList.toggle('is-active', s.getAttribute('data-shot') === id);
          });
        });
      });

      // ===== Copy-Button im Install-Hinweis =========================
      document.querySelectorAll('.v2-install-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(cmd);
            const original = btn.textContent;
            btn.textContent = 'Kopiert ✓';
            btn.classList.add('is-done');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('is-done');
            }, 1600);
          } catch (e) {
            btn.textContent = 'Bitte manuell kopieren';
            setTimeout(() => { btn.textContent = 'Kopieren'; }, 2000);
          }
        });
      });

      // ===== Sprint-Pille: Lese-Fortschritt =========================
      const sprintTxt = document.querySelector('.v2-sprint-txt');
      const paper = document.getElementById('paper');
      if (sprintTxt && paper) {
        const recount = () => {
          const active = document.querySelector('.v2-tab-content.is-active');
          const text = active ? active.textContent.trim() : '';
          const words = text ? text.split(/\s+/).length : 0;
          sprintTxt.dataset.total = String(words);
        };
        recount();
        // Recount bei Tab-Wechsel
        tabs.forEach((t) => t.addEventListener('click', () => setTimeout(recount, 50)));

        const updateProgress = () => {
          const total = parseInt(sprintTxt.dataset.total || '0', 10);
          if (total === 0) {
            sprintTxt.textContent = 'Lese-Sprint';
            return;
          }
          const top = window.scrollY;
          const max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
          const ratio = Math.min(top / max, 1);
          const read = Math.round(ratio * total);
          sprintTxt.textContent = read + ' / ' + total + ' W';
        };
        updateProgress();
        window.addEventListener('scroll', updateProgress, { passive: true });
      }
    })();
  </script>
