    padding: 88px 24px 64px;
    text-align: center;
    border-bottom: 1px dashed rgba(28,24,20,0.18);
    background: transparent;
  }
  .v2-hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .v2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #5b554c;
    margin-bottom: 24px;
  }
  .v2-eyebrow::before {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }
  .v2-h1 {
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #1c1814;
    margin: 0;
  }
  .v2-lead {
    margin: 28px auto 0;
    max-width: 60ch;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: #5b554c;
  }
  .v2-hero-cta {
    margin-top: 32px;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .v2-hero-meta {
    margin-top: 16px;
    font-size: 12px;
    color: #8a8276;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .v2-hero-meta b { color: #1c1814; font-weight: 700; }
  .v2-meta-sep { opacity: 0.4; }

  /* === Shell-Container ====================================== */
  .v2-shell {
    --v2-bg: #f5f3ee;
    --v2-paper: #ffffff;
    --v2-ink: #1c1814;
    --v2-ink-muted: rgba(28,24,20,0.65);
    --v2-ink-faint: rgba(28,24,20,0.45);
    --v2-border: rgba(28,24,20,0.10);
    --v2-border-strong: rgba(28,24,20,0.18);
    --v2-hover: rgba(28,24,20,0.05);
    --v2-paper-w: 820px;

    /* hexToTint(#e0791f, 0.28) → rgb(247, 222, 197) */
    --v2-tint-timo: rgb(247, 222, 197);
    /* hexToTint(#d04141, 0.28) → rgb(243, 207, 207) */
    --v2-tint-axel: rgb(243, 207, 207);

    background: var(--v2-bg);
    color: var(--v2-ink);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(28,24,20,0.04) 0,
        rgba(28,24,20,0.04) 1px,
        transparent 1px,
        transparent 28px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(28,24,20,0.04) 0,
        rgba(28,24,20,0.04) 1px,
        transparent 1px,
        transparent 28px
      );
    background-attachment: fixed;
    /* Schmaler Atemschritt unter dem Paper, statt eines breiten
       leeren Streifens. */
    padding-bottom: 24px;
  }

  /* === Chrome-Wrapper: titlebar + toolbar als 1 sticky Block === */
  .v2-chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--v2-bg);
    /* Kein margin/padding zwischen titlebar+toolbar - sie liegen direkt
       aneinander. So gibt es keinen Karo-Streifen dazwischen. */
  }

  /* === Titlebar ============================================ */
  .v2-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: var(--v2-bg);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-traffic { display: flex; gap: 6px; padding-right: 6px; }
  .v2-traffic .dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    display: inline-block;
    box-shadow: 0 0 0 0.5px rgba(0,0,0,0.15);
  }
  .v2-traffic .dot-red    { background: #ff5f57; }
  .v2-traffic .dot-yellow { background: #febc2e; }
  .v2-traffic .dot-green  { background: #28c840; }

  .v2-tabs {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .v2-tabs::-webkit-scrollbar { display: none; }

  .v2-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--v2-ink-muted);
    cursor: pointer;
    transition: all 120ms ease;
    font-size: 12px;
    font-weight: 500;
    min-width: 0;
    flex-shrink: 0;
    font-family: inherit;
  }
  .v2-tab:hover {
    background: var(--v2-hover);
    color: var(--v2-ink);
  }
  .v2-tab.is-active {
    background: var(--v2-paper);
    color: var(--v2-ink);
    border-color: var(--v2-border);
    box-shadow: 0 1px 2px rgba(28,24,20,0.05);
  }
  .v2-tab-icon {
    width: 38px;
    padding: 0;
    justify-content: center;
    position: relative;
  }
  .v2-tab-badge {
    /* Innerhalb der Tab-Bounds positioniert, weil .v2-tabs durch
       overflow-x: auto auch vertikal clippt. */
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #1c1814;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    line-height: 1;
  }
  .v2-tab-script {
    min-width: 110px;
    max-width: 200px;
    flex: 0 1 170px;
  }
  .v2-tab-ic { flex-shrink: 0; opacity: 0.7; }
  .v2-tab.is-active .v2-tab-ic { opacity: 1; }
  .v2-tab-title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: left;
  }
  .v2-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .v2-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--v2-paper);
    border: 1px solid var(--v2-border);
    color: var(--v2-ink-muted);
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
  }
  .v2-status-pill:hover { border-color: var(--v2-border-strong); color: var(--v2-ink); }
  .v2-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #4f9a6c;
    display: inline-block;
  }

  /* === Toolbar (Block-Pillen) ============================= */
  .v2-toolbar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    background: var(--v2-paper);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-toolbar-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 6px;
    background: transparent;
    border: 0;
    color: var(--v2-ink-muted);
    font-size: 12px;
    cursor: pointer;
    font-family: inherit;
  }
  .v2-toolbar-back:hover { background: var(--v2-hover); color: var(--v2-ink); }
  .v2-toolbar-title {
    flex: 1;
    font-weight: 700;
    font-size: 13px;
    color: var(--v2-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }
  .v2-toolbar-pills { display: inline-flex; gap: 4px; flex-shrink: 0; }
  .v2-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(28,24,20,0.04);
    color: var(--v2-ink-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .v2-pill.is-active { background: var(--v2-ink); color: #fff; }
  .v2-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 14px;
    padding: 0 3px;
    border-radius: 3px;
    background: rgba(255,255,255,0.18);
    color: inherit;
    font-size: 9px;
    font-weight: 600;
    opacity: 0.85;
  }
  .v2-pill:not(.is-active) .v2-kbd { background: rgba(28,24,20,0.07); }
  .v2-pill-more { padding: 4px 8px; }

  .v2-toolbar-actions { flex-shrink: 0; }
  .v2-toolbar-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: 6px;
    background: var(--v2-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .v2-toolbar-btn:hover { background: #0f0d0a; }

  /* === Paper (Skript-Sheet) ================================
     Bottom-margin und -padding bewusst klein gehalten, damit unter
     dem Footer kein toter Weiß-/Karo-Streifen verbleibt. Das Paper
     endet an seinem unteren Rand, gefolgt von einem schmalen
     Atemschritt im Shell-Padding-Bottom. */
  .v2-paper {
    width: var(--v2-paper-w);
    max-width: calc(100vw - 48px);
    margin: 24px auto 0;
    background: var(--v2-paper);
    padding: 40px 64px 32px;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.03),
      0 8px 24px rgba(0, 0, 0, 0.06),
      0 0 0 1px rgba(0, 0, 0, 0.04);
    border-radius: 4px;
    font-feature-settings: "liga" 1, "calt" 1;
    min-height: 60vh;
  }

  /* === Tab-Content Switching ============================== */
  .v2-tab-content {
    display: none;
    animation: v2-fade 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .v2-tab-content.is-active { display: block; }
  @keyframes v2-fade {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* === Blocks (1:1 aus Editor.css) ======================== */
  .v2-block {
    position: relative;
    margin: 0;
    padding: 0;
    white-space: normal;
    word-break: break-word;
  }
  .v2-block + .v2-block { margin-top: 4px; }
  .v2-block.v2-action + .v2-block.v2-action { margin-top: 14px; }
  .v2-block.v2-action + .v2-block.v2-character,
  .v2-block.v2-dialog + .v2-block.v2-action,
  .v2-block.v2-dialog + .v2-block.v2-character {
    margin-top: 14px;
  }
  .v2-block.v2-caption + * { margin-top: 14px; }
  * + .v2-block.v2-caption { margin-top: 32px; }

  .v2-action { text-align: left; }
  .v2-caption {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 14px;
  }
  .v2-character {
    text-align: center;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-top: 18px;
  }
  .v2-parenthetical {
    margin-left: 22%;
    margin-right: 22%;
    font-style: italic;
    color: var(--v2-ink-muted);
    text-align: left;
  }
  .v2-dialog {
    margin-left: 16%;
    margin-right: 16%;
    text-align: left;
  }
  .v2-camera {
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    font-size: 13px;
    color: var(--v2-ink-muted);
  }
  .v2-sfx {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.02em;
    font-size: 13px;
    color: var(--v2-ink-muted);
    text-transform: uppercase;
    margin-top: 14px;
  }

  /* === Charakter-Highlighting: per-Zeile via box-decoration-break.
     Genau wie in Editor.css für span[data-lexical-text]. Der
     <span class="v2-t"> wrapt den gesamten Text - der Hintergrund
     huegelt sich um jede Zeile, nicht um den ganzen Block. =========== */
  .v2-block[data-speaker] .v2-t {
    padding: 1px 4px;
    border-radius: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .v2-block[data-speaker="TIMO"] .v2-t { background: var(--v2-tint-timo); }
  .v2-block[data-speaker="AXEL"] .v2-t { background: var(--v2-tint-axel); }

  /* SFX kann ein "plain"-Span enthalten ohne Highlight */
  .v2-t-plain { font-style: italic; text-transform: none; color: var(--v2-ink-muted); }

  /* === Jump-Buttons unter jedem Tab ======================= */
  .v2-jump {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px dashed var(--v2-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .v2-jump-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--v2-ink-muted);
    margin-right: 4px;
    font-weight: 600;
  }
  .v2-jump-btn {
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(28,24,20,0.04);
    border: 0;
    color: var(--v2-ink);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 120ms ease;
  }
  .v2-jump-btn:hover {
    background: var(--v2-ink);
    color: #fff;
  }

  /* === Callout (Quickmodus) ============================== */
  .v2-callout {
    margin: 32px -32px;
    padding: 24px 28px;
    background: var(--v2-ink);
    color: #fff;
    border-radius: 4px;
  }
  .v2-callout-eyebrow {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 10px;
  }
  .v2-callout p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255,255,255,0.92);
  }

  /* === Install-Hinweis (xattr-Befehl) ====================
     Zwei Varianten: im Hero collabsierbar (<details>), im Paper
     immer offen. Code-Zeile mit Kopier-Button. */
  .v2-install {
    margin: 28px auto 0;
    max-width: 640px;
    border: 1px dashed rgba(28,24,20,0.22);
    border-radius: 8px;
    text-align: left;
    background: rgba(255,255,255,0.55);
  }
  .v2-install summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    color: #1c1814;
    user-select: none;
  }
  .v2-install summary::-webkit-details-marker { display: none; }
  .v2-install-chevron {
    color: #5b554c;
    font-size: 10px;
    transition: transform 200ms ease;
  }
  .v2-install[open] .v2-install-chevron { transform: rotate(180deg); }
  .v2-install-body {
    padding: 0 18px 16px;
  }
  .v2-install[open] .v2-install-body {
    border-top: 1px dashed rgba(28,24,20,0.12);
    padding-top: 16px;
  }
  .v2-install-text {
    margin: 0 0 10px;
    font-size: 13px;
    color: #5b554c;
    line-height: 1.55;
  }
  .v2-install-code {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 4px 4px 14px;
    border-radius: 6px;
    background: rgba(28,24,20,0.05);
    border: 1px solid rgba(28,24,20,0.08);
  }
  .v2-install-code code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: inherit;
    font-size: 13px;
    color: #1c1814;
    padding: 6px 0;
    background: transparent;
  }
  .v2-install-code code::-webkit-scrollbar { display: none; }
  .v2-install-copy {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 4px;
    background: #1c1814;
    color: #fff;
    border: 0;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 120ms ease;
  }
  .v2-install-copy:hover { background: #0f0d0a; }
  .v2-install-copy.is-done { background: #4f9a6c; }
  .v2-install-why {
    margin: 12px 0 0;
    font-size: 12px;
    color: #8a8276;
    line-height: 1.55;
  }
  .v2-install-why strong { color: #1c1814; font-weight: 700; }

  /* Im Paper voll sichtbar (kein <details>), volle Breite des
     Paper-Bereichs. Body bekommt Padding rundherum, damit der Text
     nicht an der gestrichelten Linie klemmt. */
  .v2-install-paper {
    max-width: none;
    margin: 16px 0 0;
    background: transparent;
  }
  .v2-install-paper .v2-install-body {
    padding: 18px;
    border-top: 0;
  }

  /* === No-AI Grid ========================================== */
  .v2-noai-grid {
    margin: 24px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .v2-noai-card {
    padding: 20px 18px;
    border: 1px solid var(--v2-border);
    border-radius: 4px;
    background: #fbfaf7;
  }
  .v2-noai-card-yes {
    background: var(--v2-ink);
    color: #fff;
    border-color: var(--v2-ink);
  }
  .v2-noai-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgba(208, 65, 65, 0.12);
    color: #d04141;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .v2-noai-icon-yes {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgba(47, 165, 107, 0.25);
    color: #6cc28e;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .v2-noai-card h3 {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
  }
  .v2-noai-card p {
    margin: 0;
    font-size: 13px;
    color: var(--v2-ink-muted);
    line-height: 1.55;
  }
  .v2-noai-card-yes p { color: rgba(255,255,255,0.8); }

  /* === Screenshot frame ==================================== */
  .v2-shot-wrap {
    margin: 24px 0;
    border: 1px solid var(--v2-border);
    border-radius: 12px;
    overflow: hidden;
    background: #fbfaf7;
  }
  .v2-shot-tabs {
    display: flex;
    gap: 2px;
    padding: 8px;
    background: var(--v2-paper);
    border-bottom: 1px solid var(--v2-border);
  }
  .v2-shot-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--v2-ink-muted);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all 120ms ease;
  }
  .v2-shot-tab:hover {
    background: var(--v2-hover);
    color: var(--v2-ink);
  }
  .v2-shot-tab.is-active {
    background: var(--v2-ink);
    color: #fff;
    border-color: var(--v2-ink);
  }
  .v2-shot-frame {
    /* Nur Positionierungs-Kontext, kein eigener Hintergrund/Padding.
       Das Bild fuellt direkt den .v2-shot-wrap. */
    position: relative;
  }
  .v2-shot {
    display: none;
    width: 100%;
    height: auto;
  }
  .v2-shot.is-active { display: block; }

  /* === Compare Table ====================================== */
  .v2-table-wrap {
    margin: 16px -32px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .v2-table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
    font-size: 12px;
    border: 2px solid var(--v2-ink);
  }
  .v2-table th, .v2-table td {
    text-align: left;
    padding: 10px 12px;
    border-right: 1px solid var(--v2-border);
    border-bottom: 1px solid var(--v2-border);
    vertical-align: middle;
  }
  .v2-table th:last-child, .v2-table td:last-child { border-right: 0; }
  .v2-table thead th {
    background: var(--v2-ink);
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10px;
    font-weight: 700;
    border-right-color: rgba(255,255,255,0.12);
  }
  .v2-table th.v2-table-us, .v2-table td.v2-table-us {
    background: rgba(28,24,20,0.04);
  }
  .v2-table thead th.v2-table-us {
    background: #0f0d0a;
    border-right-color: rgba(255,255,255,0.12);
  }
  .v2-table td.v2-table-crit {
    font-weight: 700;
    color: var(--v2-ink);
  }
  .v2-table tbody tr:last-child td { border-bottom: 0; }
  .v2-mark {
    display: inline-flex;
    align-items: center;
