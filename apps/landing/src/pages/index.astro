---
/**
 * ScriptZ - Landing.
 *
 * Konzept: ein Hero oben (klassisches Landingpage-Pattern), darunter
 * eine eingebettete ScriptZ-App-Simulation. Tabs sind echte Tabs:
 * jeder Klick wechselt den Paper-Inhalt, kein Scrollen zu Sektionen.
 * Die Ideen-Ansicht ist ein 1:1-Nachbau der echten App.
 *
 * Block-Styling (CAPTION, CHARACTER, DIALOG, PARENTHETICAL, ACTION,
 * CAMERA, SFX) und Charakter-Highlighting (per-Zeile via
 * box-decoration-break) spiegeln Editor.css und highlight.ts der
 * Desktop-App.
 */
import Base from "../layouts/Base.astro";
import { getLatestRelease, site } from "../data/site";

const release = await getLatestRelease();

interface Idea {
  title: string;
  body?: string;
  age: string;
  used?: boolean;
}

const openIdeas: Idea[] = [
  {
    title: "Tutorial: Vom leeren Cursor zum fertigen Skript in 5 Minuten",
    body: "Screen-Recording mit Stoppuhr. Quickmodus aktivieren, einfach drauflos tippen, exportieren - fertig. Beweis statt Behauptung.",
    age: "vor 2 Std.",
  },
  {
    title: "Warum ich Final Draft für TikTok nicht mehr nutze",
    body: "Lizenz, Drehbuch-Layout, Courier 12pt. Alles gebaut für 90 Min Film. Ich brauche 60 Sekunden.",
    age: "vor 4 Std.",
  },
  {
    title: "Eine Schweigeminute für Word-Power-User",
    body: "Klick, klick, klick, klick. Einrückung manuell. Charakter-Name fett, neue Zeile, zentriert. Tab, tab, tab.",
    age: "vor 6 Std.",
  },
  {
    title: "ScriptZ ohne KI - bewusst entschieden",
    body: "Andere Tools schreiben dir das Skript. Wir schreiben dir gar nichts. Du bist der Creator, nicht das Modell.",
    age: "vor 9 Std.",
  },
  {
    title: "Reel: Quickmodus erklärt in 30 Sekunden",
    body: "Two-hander Dialog. Enter drücken. Sprecher wechselt automatisch. Das wars.",
    age: "vor 14 Std.",
  },
  {
    title: "Was passiert, wenn man morgens nichts geschrieben hat",
    body: "Streak bricht. Heatmap-Lücke. Tag verloren. So motivierend wie der Wecker um 6 Uhr.",
    age: "vor 1 Tag",
  },
];

const usedIdeas: Idea[] = [
  {
    title: "Cliché GenZ im Bewerbungsgespräch",
    age: "gestern verwendet",
    used: true,
  },
];

const allIdeas = [...openIdeas, ...usedIdeas];
---

<Base
  title="ScriptZ - der Skripteditor für Content Creator"
  description="Schreiben statt formatieren. Eine Idee → ein fertiges Skript in wenigen Minuten. Lokal, kostenlos, Open Source. Für TikTok, Reels und YouTube Shorts."
>
  <!-- ============== HERO (bricht das Script-Frame) ============== -->
  <section class="v2-hero">
    <div class="v2-hero-inner">
      <span class="v2-eyebrow">SCRIPTZ // FÜR CONTENT CREATOR</span>
      <h1 class="v2-h1">
        Schreiben<br/>
        statt formatieren.
      </h1>
      <p class="v2-lead">
        Der Skripteditor für Content Creator. Eine Idee → ein fertiges Skript
        in wenigen Minuten. Kein Drehbuch-Korsett, keine KI, kein Abo. Nur du,
        deine Idee und ein Cursor, der dir aus dem Weg geht.
      </p>
      <div class="v2-hero-cta">
        <a class="v2-btn v2-btn-primary v2-btn-lg" href={release.dmgUrl}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
          </svg>
          Kostenlos für macOS
        </a>
        <a class="v2-btn v2-btn-ghost v2-btn-lg" href={site.github} target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2.01-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 2.91-.39c.99 0 1.98.13 2.91.39 2.22-1.5 3.2-1.18 3.2-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.2.67.8.55C20.71 21.38 24 17.07 24 12 24 5.65 18.85.5 12.5.5h-.5z"/>
          </svg>
          Auf GitHub
        </a>
      </div>
      <div class="v2-hero-meta">
        <span><b>v{release.version}</b> · macOS 13+</span>
        <span class="v2-meta-sep">·</span>
        <span>0 Tracker · 0 Konten · 0 KI</span>
      </div>

      <details class="v2-install v2-install-hero">
        <summary>
          <span class="v2-install-summary-text">Beim ersten Öffnen blockiert macOS die App?</span>
          <span class="v2-install-chevron" aria-hidden="true">▾</span>
        </summary>
        <div class="v2-install-body">
          <p class="v2-install-text">
            Das ist normal - ScriptZ ist Open Source und nicht bei
            Apple registriert. Einmal diesen Befehl im Terminal
            ausführen, danach läuft alles wie gewohnt:
          </p>
          <div class="v2-install-code">
            <code>xattr -cr /Applications/ScriptZ.app</code>
            <button class="v2-install-copy" type="button" data-copy="xattr -cr /Applications/ScriptZ.app">
              Kopieren
            </button>
          </div>
          <p class="v2-install-why">
            Apple verlangt eine kostenpflichtige Signatur, die diesen
            Schritt überflüssig machen würde. Bis sich das lohnt, ist
            der kurze Befehl der Preis dafür, dass ScriptZ kostenlos
            und ohne Konto bleibt.
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- ============== APP-SHELL ================================== -->
  <div class="v2-shell" data-theme="light">

    <!-- Chrome-Wrapper: titlebar + toolbar als sticky Einheit, damit
         kein Karo-Gap zwischen den beiden Bändern entsteht. -->
    <div class="v2-chrome">

      <!-- TAB-BAR -->
      <header class="v2-titlebar">
        <div class="v2-traffic" aria-hidden="true">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>

        <div class="v2-tabs">
          <button class="v2-tab v2-tab-icon" type="button" data-tab="home" data-title="Übersicht" aria-label="Übersicht (zurück nach oben)">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
            </svg>
          </button>
          <button class="v2-tab v2-tab-icon" type="button" data-tab="ideen" data-title="Ideen" aria-label="Ideen">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18h6"/><path d="M10 22h4"/>
              <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
            </svg>
            <span class="v2-tab-badge">{openIdeas.length}</span>
          </button>

          <button class="v2-tab v2-tab-script is-active" type="button" data-tab="warum" data-title="Skripte schreiben, ohne dass die App im Weg steht">
            <span class="v2-tab-ic">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="v2-tab-title">Warum?</span>
          </button>
          <button class="v2-tab v2-tab-script" type="button" data-tab="quickmodus" data-title="Quickmodus - der Trick, den niemand anders kann">
            <span class="v2-tab-ic">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="v2-tab-title">Der Quickmodus</span>
          </button>
          <button class="v2-tab v2-tab-script" type="button" data-tab="no-ai" data-title="Kein-KI-Manifest">
            <span class="v2-tab-ic">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="v2-tab-title">Keine KI</span>
          </button>
          <button class="v2-tab v2-tab-script" type="button" data-tab="vergleich" data-title="Im Vergleich zu allem anderen">
            <span class="v2-tab-ic">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="v2-tab-title">Vergleich</span>
          </button>
          <button class="v2-tab v2-tab-script" type="button" data-tab="download" data-title="Download - macOS, kostenlos">
            <span class="v2-tab-ic">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            </span>
            <span class="v2-tab-title">Download</span>
          </button>
        </div>

        <div class="v2-status">
          <a class="v2-status-pill" href={site.github} target="_blank" rel="noopener">
            <span class="v2-dot v2-dot-on"></span>
            Open Source
          </a>
          <span class="v2-status-pill v2-status-saved">
            <span class="v2-dot v2-dot-on"></span>
            Gespeichert
          </span>
        </div>
      </header>

      <!-- TOOLBAR -->
      <div class="v2-toolbar">
        <button class="v2-toolbar-back" type="button" data-tab="home" aria-label="Zurück zur Übersicht">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          Übersicht
        </button>
        <div class="v2-toolbar-title" id="toolbar-title">Skripte schreiben, ohne dass die App im Weg steht</div>
        <div class="v2-toolbar-pills">
          <span class="v2-pill is-active">ACTION <span class="v2-kbd">1</span></span>
          <span class="v2-pill">CHARAKTER <span class="v2-kbd">2</span></span>
          <span class="v2-pill">DIALOG <span class="v2-kbd">3</span></span>
          <span class="v2-pill v2-pill-more">…</span>
        </div>
        <div class="v2-toolbar-actions">
          <a class="v2-toolbar-btn" href={release.dmgUrl}>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
            </svg>
            Download
          </a>
        </div>
      </div>

    </div><!-- /v2-chrome -->

    <!-- ============== PAPER (Tab-Content) ====================== -->
    <main class="v2-paper" id="paper">

      <!-- ===== TAB: WARUM ===== -->
      <section class="v2-tab-content is-active" data-content="warum">
        <div class="v2-block v2-caption">INT. WRITE-SCRIPTZ.COM — JETZT</div>

        <div class="v2-block v2-action">
          Eine leere Seite. Cursor blinkt. Du tippst und das Format passiert
          von allein. Charakter-Name? Automatisch zentriert und in Versalien.
          Tabulator? Block-Wechsel. Enter? Nächste Zeile - meistens schon im
          richtigen Block.
        </div>

        <div class="v2-block v2-action">
          ScriptZ ist für Content Creator gebaut, nicht für Drehbuchautoren.
          Du willst kein 90-Minuten-Spielfilm-Layout. Du willst ein TikTok-Skript
          um halb drei fertig haben, bevor das gute Licht weg ist.
        </div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-parenthetical" data-speaker="TIMO"><span class="v2-t">(direkt)</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">Du tippst, der Editor formatiert. Charaktere werden automatisch erkannt, kriegen eine Farbe, eine Sprechzeit-Statistik. Du musst nichts anlegen. Du musst nichts klicken. Du musst nur schreiben.</span></div>

        <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
        <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">Das klingt nach jedem Tool seit 2015.</span></div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">Probier's. Mach ein Skript, schreib zwei Sprecher. Dann drück Enter. Du wirst sehen, dass der Cursor schon im richtigen Block landet, mit dem richtigen Sprecher davor. Das ist der Quickmodus. Genau das spart dir pro Wechsel zwei Tastendrücke - und bei einem 60-Sekunden-Reel mit 12 Wechseln spart das eine Minute.</span></div>

        <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
        <div class="v2-block v2-parenthetical" data-speaker="AXEL"><span class="v2-t">(neugierig)</span></div>
        <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">Und KI? Macht sie mir vor, was ich sagen soll?</span></div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">Nein. Bewusst nicht. Kreativität ist dein Job. Wenn du wolltest, dass ein Modell für dich schreibt, hättest du ChatGPT auf.</span></div>

        <div class="v2-block v2-camera">CUT TO: SCREENSHOT</div>

        <div class="v2-block v2-action">
          Drei Ansichten der App. Klick die Tabs - die App ist diese Tabs.
        </div>

        <div class="v2-shot-wrap">
          <div class="v2-shot-tabs" role="tablist">
            <button class="v2-shot-tab is-active" type="button" data-shot="overview" role="tab" aria-selected="true">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
              </svg>
              Übersicht
            </button>
            <button class="v2-shot-tab" type="button" data-shot="ideas" role="tab" aria-selected="false">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18h6"/><path d="M10 22h4"/>
                <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
              </svg>
              Ideen
            </button>
            <button class="v2-shot-tab" type="button" data-shot="editor" role="tab" aria-selected="false">
              <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
              </svg>
              Editor
            </button>
          </div>
          <div class="v2-shot-frame">
            <img class="v2-shot is-active" src="/img/app/overview.png" alt="ScriptZ Übersicht mit Skript-Liste und Charakteren" data-shot="overview" loading="lazy" />
            <img class="v2-shot" src="/img/app/ideas.png" alt="ScriptZ Ideen-Inbox" data-shot="ideas" loading="lazy" />
            <img class="v2-shot" src="/img/app/editor.png" alt="ScriptZ Editor mit Charakter-Highlights und Cast-Sidebar" data-shot="editor" loading="lazy" />
          </div>
        </div>

        <div class="v2-jump">
          <span class="v2-jump-label">Weiter im Programm:</span>
          <button class="v2-jump-btn" type="button" data-tab="quickmodus">→ Quickmodus erklärt</button>
          <button class="v2-jump-btn" type="button" data-tab="no-ai">→ Warum kein KI</button>
          <button class="v2-jump-btn" type="button" data-tab="vergleich">→ Vergleich mit anderen</button>
        </div>
      </section>

      <!-- ===== TAB: QUICKMODUS ===== -->
      <section class="v2-tab-content" data-content="quickmodus">
        <div class="v2-block v2-caption">INT. QUICKMODUS — ZWEI SPRECHER, EIN FLOW</div>

        <div class="v2-block v2-action">
          Der Quickmodus ist das, was ScriptZ nicht ersetzbar macht. Sobald
          dein Skript genau zwei Sprecher hat, übernimmt er. Nach jedem Dialog
          und einmal Enter springt der Cursor automatisch in den anderen
          Charakter und gleich rein in den nächsten Dialog. Kein Tab, kein
          Sprechername tippen, kein zweites Enter.
        </div>

        <div class="v2-block v2-sfx">SFX: <span class="v2-t-plain">tack-tack-tack</span></div>

        <div class="v2-block v2-action">
          Praktisch heißt das: pro Sprecherwechsel zwei Tastendrücke gespart.
          Bei einem typischen 60-Sekunden-Reel mit zehn bis zwölf Wechseln ist
          das fast eine Minute. Pro Tag drei Skripte? Drei Minuten. Pro Woche?
          Eine viertel Stunde, in der du nicht formatiert, sondern geschrieben
          hast.
        </div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">So sieht das in echt aus. Ich tippe etwas.</span></div>

        <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
        <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">Ich antworte. Enter.</span></div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">Cursor ist schon hier. Niemand hat „TIMO" getippt.</span></div>

        <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
        <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">Niemand hat „AXEL" getippt. Niemand hat Tab gedrückt.</span></div>

        <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
        <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">Wir schreiben einfach. Der Editor weiß, was wir wollen.</span></div>

        <div class="v2-block v2-action">
          Drei Charaktere im Skript? Quickmodus pausiert automatisch - dann
          weiß der Editor nicht, wer als Nächster spricht. Sobald du wieder
          auf zwei reduzierst, ist er wieder da. Kein Schalter, kein Setting,
          kein Lernen.
        </div>

        <div class="v2-callout">
          <span class="v2-callout-eyebrow">DAS DETAIL, DAS ZÄHLT</span>
          <p>
            Das machen weder Word, noch Notion, noch Final Draft, noch
            ChatGPT, noch Apple Notes. Wir auch nicht in Version 1.0 - aber
            seit v0.7 ist es drin. Wer schon mal zwei Sprecher gleichzeitig
            getippt hat, weiß, was das pro Tag spart.
          </p>
        </div>

        <div class="v2-jump">
          <span class="v2-jump-label">Weiter:</span>
          <button class="v2-jump-btn" type="button" data-tab="no-ai">→ Warum keine KI</button>
          <button class="v2-jump-btn" type="button" data-tab="vergleich">→ Vergleich</button>
          <button class="v2-jump-btn" type="button" data-tab="download">→ Download</button>
        </div>
      </section>

      <!-- ===== TAB: NO-AI ===== -->
      <section class="v2-tab-content" data-content="no-ai">
        <div class="v2-block v2-caption">INT. KEIN-KI-MANIFEST</div>

        <div class="v2-block v2-action">
          ScriptZ hat keine KI eingebaut. Kein Chatfenster, kein „schreib mir
