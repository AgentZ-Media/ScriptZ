---
// Vergleichstabelle: ScriptZ vs. Word/Docs, Notion, ChatGPT, Final Draft, Apple Notes.
type Mark = { kind: "yes" | "no" | "meh"; label: string };
type Row = { crit: string; us: Mark; word: Mark; notion: Mark; gpt: Mark; finalDraft: Mark; notes: Mark };

const rows: Row[] = [
  {
    crit: "Format passiert ohne dich",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "no", label: "Nein" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "meh", label: "Für Spielfilm" },
    notes: { kind: "no", label: "Nein" },
  },
  {
    crit: "Charaktere automatisch erkannt",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "no", label: "Nein" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "yes", label: "Ja" },
    notes: { kind: "no", label: "Nein" },
  },
  {
    crit: "Auf Short-Form ausgelegt",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "no", label: "Nein" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "no", label: "Nein, Spielfilm" },
    notes: { kind: "no", label: "Nein" },
  },
  {
    crit: "Kostenlos & lokal",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "no", label: "Cloud, Plan" },
    gpt: { kind: "no", label: "Cloud, Plan" },
    finalDraft: { kind: "no", label: "Bezahl" },
    notes: { kind: "meh", label: "Ja, Apple-only" },
  },
  {
    crit: "Auf in < 1 s",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "meh", label: "Naja" },
    notion: { kind: "no", label: "Nein" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "no", label: "Nein" },
    notes: { kind: "yes", label: "Ja" },
  },
  {
    crit: "Streak + Tagesziel + Heatmap",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "no", label: "Nein" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "no", label: "Nein" },
    notes: { kind: "no", label: "Nein" },
  },
  {
    crit: "Ideen-Inbox direkt drin",
    us: { kind: "yes", label: "Ja" },
    word: { kind: "no", label: "Nein" },
    notion: { kind: "meh", label: "Manuell" },
    gpt: { kind: "no", label: "Nein" },
    finalDraft: { kind: "no", label: "Nein" },
    notes: { kind: "meh", label: "Manuell" },
  },
];

const cols: { key: keyof Row; label: string }[] = [
  { key: "word", label: "Word / Docs" },
  { key: "notion", label: "Notion" },
  { key: "gpt", label: "ChatGPT" },
  { key: "finalDraft", label: "Final Draft" },
  { key: "notes", label: "Apple Notes" },
];
---

<section class="compare" id="vergleich">
  <div class="container">
    <div class="compare-head">
      <span class="eyebrow">Im Vergleich</span>
      <h2 class="h-section">Andere Tools können vieles. Wir können <em>das hier</em>.</h2>
      <p class="lead">
        Word, Notion, Final Draft - alles tolle Programme. Keins davon
        ist für „heute drei TikTok-Skripte raushauen" gebaut.
      </p>
    </div>

    <div class="compare-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th>Was du brauchst</th>
            <th class="us">ScriptZ</th>
            {cols.map((c) => <th>{c.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="crit">{row.crit}</td>
              <td class="us">
                <span class={`mark ${row.us.kind}`}>
                  {row.us.kind === "yes" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  )}
                  {row.us.label}
                </span>
              </td>
              {cols.map((c) => {
                const cell = row[c.key] as Mark;
                return (
                  <td>
                    <span class={`mark ${cell.kind}`}>{cell.label}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare {
    padding: var(--sp-12) 0;
  }
  .compare-head {
    max-width: 64ch;
  }
  .compare-head h2 {
    margin-top: var(--sp-4);
  }
  .compare-head .lead {
    margin-top: var(--sp-5);
  }

  .compare-wrap {
    margin-top: var(--sp-8);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    min-width: 760px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-5);
    overflow: hidden;
    border-collapse: separate;
    border-spacing: 0;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: var(--sp-4);
    font-size: var(--fs-13);
    border-bottom: 1px solid var(--border-paper);
    vertical-align: middle;
  }
  .compare-table th:first-child,
  .compare-table td:first-child {
    padding-left: var(--sp-6);
  }
  .compare-table th:last-child,
  .compare-table td:last-child {
    padding-right: var(--sp-6);
  }
  .compare-table thead th {
    font-weight: 700;
    color: var(--fg);
    background: var(--bg-elev-2);
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-13);
  }
  .compare-table thead th.us {
    background: var(--brand-500);
    color: #fff;
  }
  .compare-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare-table td.crit {
    font-weight: 700;
    color: var(--fg);
  }
  .compare-table td.us {
    background: rgba(28, 24, 20, 0.025);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-13);
    color: var(--fg-muted);
  }
  .mark.yes { color: #0c7a4a; }
  .mark.no { color: #9a4040; }
  .mark.meh { color: #9a7a3c; }
  .mark svg {
    width: 14px;
    height: 14px;
  }
</style>
