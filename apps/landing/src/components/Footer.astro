---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="foot2">
  <div class="container">
    <div class="foot2-grid">
      <div class="foot2-brand">
        <a class="logo" href="/" aria-label="Startseite">
          <img src="/img/icon.png" alt="" width="22" height="22" />
          <span>ScriptZ</span>
        </a>
        <p>
          Der minimalistische Skripteditor für Short-Form-Creator.
          Gebaut von <a href="https://linktr.ee/deragentz" target="_blank" rel="noopener noreferrer">AgentZ</a> in Schwerin.
        </p>
      </div>

      <div>
        <h5>Produkt</h5>
        <ul>
          <li><a href="/#funktionen">Funktionen</a></li>
          <li><a href="/#vergleich">Vergleich</a></li>
          <li><a href="/#download">Download</a></li>
          <li><a href={site.releasesPage} target="_blank" rel="noopener noreferrer">Changelog</a></li>
        </ul>
      </div>

      <div>
        <h5>Über</h5>
        <ul>
          <li><a href="/#ueber-uns">Über uns</a></li>
          <li><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={`${site.github}/issues`} target="_blank" rel="noopener noreferrer">Bug melden</a></li>
        </ul>
      </div>

      <div>
        <h5>Kontakt &amp; Recht</h5>
        <ul>
          <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <div class="foot2-meta">
      <div>© {year} AgentZ - ScriptZ ist Open Source unter MIT.</div>
      <div>Made in Germany. Lokal. Ohne Tracking.</div>
    </div>
  </div>
</footer>

<style>
  .foot2 {
    padding: var(--sp-11) 0 var(--sp-9);
    border-top: 1px solid var(--border);
    color: var(--fg-subtle);
    font-size: var(--fs-13);
  }
  .foot2-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--sp-7);
  }
  @media (max-width: 760px) {
    .foot2-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-7); }
  }
  @media (max-width: 480px) {
    .foot2-grid { grid-template-columns: 1fr; }
  }

  .foot2-grid h5 {
    font-size: var(--fs-13);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    font-weight: 700;
  }
  .foot2-grid ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: var(--sp-4);
  }
  .foot2-grid a {
    color: var(--fg-muted);
    font-size: var(--fs-14);
  }
  .foot2-grid a:hover { color: var(--fg); }

  .foot2-brand {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .foot2-brand .logo {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-weight: 700;
    color: var(--fg);
  }
  .foot2-brand .logo img { border-radius: 5px; }
  .foot2-brand p {
    color: var(--fg-muted);
    font-size: var(--fs-13);
    max-width: 32ch;
    line-height: 1.55;
  }
  .foot2-brand p a {
    color: var(--fg);
    border-bottom: 1px solid var(--border-strong);
  }

  .foot2-meta {
    margin-top: var(--sp-9);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-5);
    flex-wrap: wrap;
    color: var(--fg-subtle);
    font-size: var(--fs-13);
  }
</style>
