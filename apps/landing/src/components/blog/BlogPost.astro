---
/**
 * BlogPost - die Detailseite eines einzelnen Beitrags.
 *
 * Erwartet ein bereits aufgeloestes `BlogEntry` und rendert Header,
 * Cover, Body (durch das Remark-Dialog-Plugin gegangen) sowie Tags und
 * Post-Footer. JSON-LD-Artikel-Schema wird hier injectet, damit die
 * Page-Route schlank bleibt.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import {
  type BlogEntry,
  formatDate,
  isoDate,
  blogIndexPath,
  readingTimeMinutes,
} from "../../lib/blog";
import { t, tFormat, tPlural, type Lang } from "../../i18n";
import { site } from "../../data/site";
import "../../styles/blog.css";

interface Props {
  entry: BlogEntry;
  lang: Lang;
  /** Existiert eine Uebersetzung in der jeweils anderen Sprache?
   *  Steuert nur den Hinweis-Banner, der Sprach-Toggle in der Shell
   *  wird vom Page-Wrapper ueberschrieben. */
  hasOther: boolean;
}

const { entry, lang, hasOther } = Astro.props;
const { Content } = await render(entry);

const minutes = readingTimeMinutes(entry.body);
const dateStr = formatDate(entry.data.date, lang);
const updatedStr = entry.data.updated ? formatDate(entry.data.updated, lang) : null;

const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();

// JSON-LD BlogPosting-Schema. Image: bevorzugt Cover, fallback OG-Default.
const articleLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: isoDate(entry.data.date),
  inLanguage: lang === "en" ? "en" : "de",
  url: canonicalUrl,
  author: {
    "@type": "Person",
    name: entry.data.author,
  },
  publisher: {
    "@type": "Organization",
    name: "AgentZ Media",
    url: site.url,
    logo: {
      "@type": "ImageObject",
      url: `${site.url}/img/icon-large.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};
if (entry.data.updated) {
  articleLd.dateModified = isoDate(entry.data.updated);
}
if (entry.data.cover) {
  articleLd.image = new URL(entry.data.cover.src, site.url).toString();
} else {
  articleLd.image = `${site.url}/img/icon-large.png`;
}
---

<article class="blog-post">
  <a class="blog-post-back" href={blogIndexPath(lang)}>{t(lang, "blog.back")}</a>

  <p class="blog-post-meta">
    <time datetime={isoDate(entry.data.date)}>{tFormat(lang, "blog.publishedOn", { date: dateStr })}</time>
    <span class="blog-post-meta-sep">·</span>
    <span>{tPlural(lang, "blog.readingTime", minutes)}</span>
    <span class="blog-post-meta-sep">·</span>
    <span>{tFormat(lang, "blog.author.by", { name: entry.data.author })}</span>
    {updatedStr && (
      <>
        <span class="blog-post-meta-sep">·</span>
        <time datetime={isoDate(entry.data.updated!)}>{tFormat(lang, "blog.updatedOn", { date: updatedStr })}</time>
      </>
    )}
  </p>

  <h1 class="blog-post-title">{entry.data.title}</h1>
  <p class="blog-post-description">{entry.data.description}</p>

  {entry.data.cover && (
    <Image
      src={entry.data.cover}
      alt={entry.data.coverAlt ?? entry.data.title}
      class="blog-post-cover"
      widths={[480, 720, 1080, 1440]}
      sizes="(max-width: 720px) 100vw, 720px"
      loading="eager"
    />
  )}

  {!hasOther && (
    <p class="blog-post-banner">{t(lang, "blog.notTranslated")}</p>
  )}

  <div class="blog-body">
    <Content />
  </div>

  {entry.data.tags.length > 0 && (
    <div class="blog-post-tags">
      {entry.data.tags.map((tag) => (
        <span class="blog-post-tag">{tag}</span>
      ))}
    </div>
  )}

  <footer class="blog-post-footer">
    <a class="blog-post-back" href={blogIndexPath(lang)}>{t(lang, "blog.back")}</a>
    <p class="blog-post-end">— ENDE —</p>
  </footer>
</article>

<script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
