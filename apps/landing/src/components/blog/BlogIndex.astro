---
/**
 * BlogIndex - die Uebersichts-Seite (`/blog`, `/en/blog`).
 *
 * Liste der Posts in der aktuellen Sprache, neueste zuerst. Drafts
 * werden ausserhalb von `dev` weggefiltert. Underscore-Slugs wie
 * `_example/` erscheinen nie - das ist die Template-Konvention.
 */
import { Image } from "astro:assets";
import { getPosts, postPath, formatDate, isoDate, readingTimeMinutes } from "../../lib/blog";
import { t, tPlural, type Lang } from "../../i18n";
import "../../styles/blog.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const posts = await getPosts(lang);
---

<section class="blog-index">
  <p class="blog-index-eyebrow">{t(lang, "blog.index.eyebrow")}</p>
  <h1 class="blog-index-h1">{t(lang, "blog.index.h1")}</h1>
  <p class="blog-index-lead">{t(lang, "blog.index.lead")}</p>

  <a class="blog-index-rss" href={lang === "de" ? "/rss.xml" : "/en/rss.xml"} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
      <path d="M4 4v3a13 13 0 0 1 13 13h3A16 16 0 0 0 4 4zm0 6v3a7 7 0 0 1 7 7h3a10 10 0 0 0-10-10zm2 8.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
    </svg>
    {t(lang, "blog.index.rss.label")}
  </a>

  {posts.length === 0 ? (
    <p class="blog-index-empty">{t(lang, "blog.index.empty")}</p>
  ) : (
    <ul class="blog-list">
      {posts.map((entry) => {
        const slug = entry.id.replace(/\/(de|en)$/, "");
        const href = postPath(slug, lang);
        const date = entry.data.date;
        const minutes = readingTimeMinutes(entry.body);
        return (
          <li class="blog-list-item">
            <a class="blog-list-link" href={href}>
              <div>
                <p class="blog-list-meta">
                  <time datetime={isoDate(date)}>{formatDate(date, lang)}</time>
                  <span class="blog-list-meta-sep">·</span>
                  <span>{tPlural(lang, "blog.readingTime", minutes)}</span>
                </p>
                <h2 class="blog-list-title">{entry.data.title}</h2>
                <p class="blog-list-description">{entry.data.description}</p>
                {entry.data.tags.length > 0 && (
                  <div class="blog-list-tags">
                    {entry.data.tags.map((tag) => (
                      <span class="blog-list-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              {entry.data.cover && (
                <Image
                  src={entry.data.cover}
                  alt={entry.data.coverAlt ?? ""}
                  class="blog-list-cover"
                  widths={[140, 280]}
                  sizes="140px"
                  loading="lazy"
                />
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )}
</section>
