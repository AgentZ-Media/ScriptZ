---
/**
 * AppShell - the app showcase on the landing.
 *
 * Contains: titlebar with tab bar (real `<a>` links instead of JS
 * tabs), toolbar with pills + download button, footer, sprint pill,
 * and the inline script for platform detect, copy button, screenshot
 * gallery, sprint progress and language-toggle persistence.
 *
 * What is NOT in here: the hero (home only), the section markup per
 * tab (comes in via `<slot/>`). That keeps each page small and able
 * to carry its own title/meta.
 *
 * View transitions: the chrome carries `transition:persist` so it
 * isn't re-mounted on route change. Active-tab and toolbar-title
 * updates happen in the `astro:after-swap` handler in Base.astro,
 * not here.
 */
import { getLatestRelease, site } from "../data/site";
import { routePath, switchLangPath, t, type Lang, type RouteKey } from "../i18n";
import SiteFooter from "./SiteFooter.astro";
import "../styles/landing.css";

interface Props {
  lang: Lang;
  /** Which content tab does this page belong to? Determines the
   *  `is-active` class on the tab button and the toolbar title. For
   *  blog posts `activeTab` is still `"blog"` but there is no tab in
   *  the tab bar - the bar shows no "is-active" class, because blog
   *  isn't rendered there as a tab. */
  activeTab: RouteKey;
  /** Optional: overrides the toolbar title. Blog-post pages pass the
   *  post title here instead of a generic tab label. */
  toolbarTitleOverride?: string;
  /** Optional: overrides the target URL of the language toggle. Used
   *  for blog posts, where the slug may or may not exist and the page
   *  itself must make that decision. */
  switchLangHrefOverride?: string;
}

const { lang, activeTab, toolbarTitleOverride, switchLangHrefOverride } = Astro.props;
const release = await getLatestRelease();

const otherLang: Lang = lang === "de" ? "en" : "de";
const currentRoutePath = routePath(lang, activeTab);
const switchHref = switchLangHrefOverride ?? switchLangPath(lang, otherLang, currentRoutePath);

// Toolbar title per active tab. The download tab additionally depends
// on the platform; the inline script adjusts that via a data attribute.
// Blog also passes through here but has no dedicated tab in the tab
// bar - the title is still useful in case no override applies.
const titleKeyMap: Record<RouteKey, Parameters<typeof t>[1]> = {
  home: "tab.home.long",
  warum: "tab.warum.long",
  quickmodus: "tab.quickmodus.long",
  "no-ai": "tab.noai.long",
  vergleich: "tab.compare.long",
  download: "tab.download.long.mac",
  ideen: "tab.ideas.title",
  blog: "blog.toolbar.title.index",
};
const toolbarTitle = toolbarTitleOverride ?? t(lang, titleKeyMap[activeTab]);

// Paths per tab in the current language, computed once so the markup
// below stays readable.
const links = {
  home: routePath(lang, "home"),
  ideen: routePath(lang, "ideen"),
  warum: routePath(lang, "warum"),
  quickmodus: routePath(lang, "quickmodus"),
  "no-ai": routePath(lang, "no-ai"),
  vergleich: routePath(lang, "vergleich"),
  download: routePath(lang, "download"),
  blog: routePath(lang, "blog"),
};

// Ideas list for the tab badge (count of open ideas). In the footer
// and sprint logic the exact entries aren't needed - only in the
// ideas tab itself, where IdeenSection renders them independently.
const openIdeasCount = 6;

// Pass JS-side strings down to the inline script.
const jsStrings = {
  copy: t(lang, "install.copy"),
  copied: t(lang, "install.copied"),
  copyManual: t(lang, "install.copyManual"),
  sprintLabel: t(lang, "sprint.label"),
  sprintFormat: "{r} / {t} W",
};
---

<div class="v2-shell" data-theme="light">

  <!-- Chrome (titlebar + toolbar) - re-rendered on every route
       change. NO `transition:persist`, otherwise the tab labels
       stay in the first page's language and the language toggle
       doesn't swap its active pill. View transitions still deliver
       the soft cross-fade.                                              -->
  <div class="v2-chrome">

    <!-- TAB-BAR -->
    <header class="v2-titlebar">
      <div class="v2-traffic" aria-hidden="true">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>

      <div class="v2-tabs">
        <a class:list={["v2-tab", "v2-tab-icon", activeTab === "home" && "is-active"]} href={links.home} data-tab="home" data-title={t(lang, "tab.home.long")} aria-label={t(lang, "tab.home.aria")}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
          </svg>
        </a>
        <a class:list={["v2-tab", "v2-tab-icon", activeTab === "ideen" && "is-active"]} href={links.ideen} data-tab="ideen" data-title={t(lang, "tab.ideas.title")} aria-label={t(lang, "tab.ideas.aria")}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 18h6"/><path d="M10 22h4"/>
            <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
          </svg>
          <span class="v2-tab-badge">{openIdeasCount}</span>
        </a>

        <a class:list={["v2-tab", "v2-tab-script", activeTab === "warum" && "is-active"]} href={links.warum} data-tab="warum" data-title={t(lang, "tab.warum.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.warum.short")}</span>
        </a>
        <a class:list={["v2-tab", "v2-tab-script", activeTab === "quickmodus" && "is-active"]} href={links.quickmodus} data-tab="quickmodus" data-title={t(lang, "tab.quickmodus.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.quickmodus.short")}</span>
        </a>
        <a class:list={["v2-tab", "v2-tab-script", activeTab === "no-ai" && "is-active"]} href={links["no-ai"]} data-tab="no-ai" data-title={t(lang, "tab.noai.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.noai.short")}</span>
        </a>
        <a class:list={["v2-tab", "v2-tab-script", activeTab === "vergleich" && "is-active"]} href={links.vergleich} data-tab="vergleich" data-title={t(lang, "tab.compare.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.compare.short")}</span>
        </a>
        <a class:list={["v2-tab", "v2-tab-script", "js-tab-download", activeTab === "download" && "is-active"]} href={links.download} data-tab="download" data-title={t(lang, "tab.download.long.mac")} data-title-mac={t(lang, "tab.download.long.mac")} data-title-win={t(lang, "tab.download.long.win")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.download.short")}</span>
        </a>
      </div>

      <div class="v2-status">
        <div class="v2-lang" role="group" aria-label={t(lang, "lang.toggle.aria")}>
          {lang === "de" ? (
            <>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.de")}</span>
              <a class="v2-lang-pill" href={switchHref} hreflang="en" data-lang-set="en">{t(lang, "lang.toggle.en")}</a>
            </>
          ) : (
            <>
              <a class="v2-lang-pill" href={switchHref} hreflang="de" data-lang-set="de">{t(lang, "lang.toggle.de")}</a>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.en")}</span>
            </>
          )}
        </div>
        <a class="v2-status-pill" href={site.github} target="_blank" rel="noopener">
          <span class="v2-dot v2-dot-on"></span>
          {t(lang, "status.opensource")}
        </a>
        <span class="v2-status-pill v2-status-saved">
          <span class="v2-dot v2-dot-on"></span>
          {t(lang, "status.saved")}
        </span>
      </div>
    </header>

    <!-- TOOLBAR -->
    <div class="v2-toolbar">
      <a class="v2-toolbar-back" href={links.home} data-tab="home" aria-label={t(lang, "toolbar.back.aria")}>
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {t(lang, "toolbar.back.label")}
      </a>
      <div class="v2-toolbar-title" id="toolbar-title">{toolbarTitle}</div>
      <div class="v2-toolbar-pills">
        <span class="v2-pill is-active">{t(lang, "toolbar.pill.action")} <span class="v2-kbd">1</span></span>
        <span class="v2-pill">{t(lang, "toolbar.pill.character")} <span class="v2-kbd">2</span></span>
        <span class="v2-pill">{t(lang, "toolbar.pill.dialog")} <span class="v2-kbd">3</span></span>
        <span class="v2-pill v2-pill-more">…</span>
      </div>
      <div class="v2-toolbar-actions">
        <a
          class="v2-toolbar-btn js-platform-cta"
          href={release.dmgUrl}
          data-href-mac={release.dmgUrl}
          data-href-win={release.exeUrl}
        >
          <svg class="js-platform-icon-mac" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
          </svg>
          <svg class="js-platform-icon-win" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
          </svg>
          {t(lang, "toolbar.download")}
        </a>
      </div>
    </div>

  </div><!-- /v2-chrome -->

  <!-- PAPER (section content + footer) - swaps per route. -->
  <main class="v2-paper" id="paper">
    <slot />

    <!-- Footer - one component for all shells (see SiteFooter.astro) -->
    <SiteFooter lang={lang} />
  </main>

  <!-- SPRINT PILL - re-renders per route (word count is page-
       specific anyway, and the label has to follow language switches). -->
  <div
    class="v2-sprint"
    id="sprint"
    data-label={jsStrings.sprintLabel}
    data-format={jsStrings.sprintFormat}
  >
    <span class="v2-sprint-ring">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" stroke-opacity="0.22"/>
        <circle
          class="v2-sprint-progress"
          cx="12" cy="12" r="9"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-dasharray="56.5487"
          stroke-dashoffset="56.5487"
          transform="rotate(-90 12 12)"
        />
      </svg>
    </span>
    <span class="v2-sprint-txt">{jsStrings.sprintLabel}</span>
  </div>
</div><!-- /v2-shell -->

<!-- Platform CTA update + sprint recount + copy button + language
     toggle persistence + screenshot gallery. Runs on first load and
     is re-triggered in Base.astro after every ClientRouter swap
     (astro:page-load). Hence `is:inline` without `data-astro-rerun`. -->
<script is:inline define:vars={{ jsStrings }}>
  // Global init function so Base.astro can call it again after
  // astro:page-load. Uses fixed symbols on the window object.
  window.__scriptzShellInit = function () {
    // ===== Platform CTA update ====================================
    var platform = document.documentElement.getAttribute('data-platform') || 'macos';
    var isWin = platform === 'windows';

    document.querySelectorAll('.js-platform-cta').forEach(function (el) {
      var hrefMac = el.getAttribute('data-href-mac');
      var hrefWin = el.getAttribute('data-href-win');
      var labelMac = el.getAttribute('data-label-mac');
      var labelWin = el.getAttribute('data-label-win');
      if (isWin && hrefWin) el.setAttribute('href', hrefWin);
      else if (hrefMac) el.setAttribute('href', hrefMac);
      var labelEl = el.querySelector('.js-platform-label');
      if (labelEl) labelEl.textContent = (isWin ? labelWin : labelMac) || labelEl.textContent;
    });

    var dlTab = document.querySelector('.js-tab-download');
    if (dlTab) {
      var tMac = dlTab.getAttribute('data-title-mac');
      var tWin = dlTab.getAttribute('data-title-win');
      dlTab.setAttribute('data-title', (isWin ? tWin : tMac) || dlTab.getAttribute('data-title'));
    }

    // ===== Screenshot gallery =====================================
    var shotTabs = document.querySelectorAll('.v2-shot-tab');
    var shots = document.querySelectorAll('.v2-shot');
    shotTabs.forEach(function (tab) {
      // Idempotent: remove the old listener, register a new one
      if (tab.__handler) tab.removeEventListener('click', tab.__handler);
      var handler = function () {
        var id = tab.getAttribute('data-shot');
        shotTabs.forEach(function (x) {
          var on = x === tab;
          x.classList.toggle('is-active', on);
          x.setAttribute('aria-selected', String(on));
        });
        shots.forEach(function (s) {
          s.classList.toggle('is-active', s.getAttribute('data-shot') === id);
        });
      };
      tab.__handler = handler;
      tab.addEventListener('click', handler);
    });

    // ===== Copy button in the install hint ========================
    document.querySelectorAll('.v2-install-copy').forEach(function (btn) {
      if (btn.__handler) btn.removeEventListener('click', btn.__handler);
      var handler = async function () {
        var cmd = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(cmd);
          btn.textContent = jsStrings.copied;
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = jsStrings.copy;
            btn.classList.remove('is-done');
          }, 1600);
        } catch (e) {
          btn.textContent = jsStrings.copyManual;
          setTimeout(function () { btn.textContent = jsStrings.copy; }, 2000);
        }
      };
      btn.__handler = handler;
      btn.addEventListener('click', handler);
    });

    // ===== Sprint pill: word-count recount ========================
    var sprintEl = document.getElementById('sprint');
    var sprintTxt = document.querySelector('.v2-sprint-txt');
    var sprintRing = document.querySelector('.v2-sprint-progress');
    var paper = document.getElementById('paper');
    var sprintLabel = sprintEl ? sprintEl.getAttribute('data-label') || 'Sprint' : 'Sprint';
    var sprintFormat = sprintEl ? sprintEl.getAttribute('data-format') || '{r} / {t} W' : '{r} / {t} W';
    var RING_CIRC = 56.5487;

    if (sprintTxt && paper) {
      var contentEl = paper.querySelector('.v2-tab-content');
      var text = contentEl ? contentEl.textContent.trim() : '';
      var words = text ? text.split(/\s+/).length : 0;
      sprintTxt.dataset.total = String(words);

      // Remove the old scroll listener from window if present
      if (window.__sprintScrollHandler) {
        window.removeEventListener('scroll', window.__sprintScrollHandler);
      }
      var updateProgress = function () {
        var total = parseInt(sprintTxt.dataset.total || '0', 10);
        var top = window.scrollY;
        var max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        var ratio = Math.min(Math.max(top / max, 0), 1);
        if (sprintRing) {
          sprintRing.setAttribute('stroke-dashoffset', String(RING_CIRC * (1 - ratio)));
        }
        if (total === 0) {
          sprintTxt.textContent = sprintLabel;
          return;
        }
        var read = Math.round(ratio * total);
        sprintTxt.textContent = sprintFormat.replace('{r}', String(read)).replace('{t}', String(total));
      };
      window.__sprintScrollHandler = updateProgress;
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
    }

    // ===== Language toggle: persist selection =====================
    document.querySelectorAll('[data-lang-set]').forEach(function (el) {
      if (el.__handler) el.removeEventListener('click', el.__handler);
      var handler = function () {
        var target = el.getAttribute('data-lang-set');
        if (target) {
          try { localStorage.setItem('scriptz-lang', target); } catch (_) { /* private mode */ }
        }
      };
      el.__handler = handler;
      el.addEventListener('click', handler);
    });
  };

  // First call on classic page load. On ClientRouter navigation,
  // Base.astro re-triggers this function via astro:page-load.
  window.__scriptzShellInit();
</script>
