---
/**
 * SiteFooter - the one footer all pages share.
 *
 * Included by both AppShell (landing routes including blog) and
 * LegalShell (Impressum, Datenschutz). Blog and RSS links thus
 * appear automatically on every page without having to maintain
 * each shell separately.
 *
 * Language:
 *  - AppShell passes its `lang` prop through (DE or EN).
 *  - LegalShell is DE-only for legal reasons and calls the footer
 *    with `lang="de"` - the toggle doesn't exist on legal pages.
 *
 * The platform-specific version line ("macOS 13+" vs "Windows 10+")
 * runs through the global `data-platform` attributes that Base.astro
 * sets before the first paint. The `.mac-only` / `.win-only` rules
 * come from landing.css for landing pages and are additionally
 * defined scoped here, so the footer also switches correctly on
 * pages without the global landing.css import (e.g. legal).
 */
import { getLatestRelease, site } from "../data/site";
import { routePath, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const release = await getLatestRelease();

const blogHref = routePath(lang, "blog");
const rssHref = lang === "de" ? "/rss.xml" : "/en/rss.xml";
---

<footer class="v2-footer">
  <div class="v2-footer-cols">
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.project")}</span>
      <ul>
        <li><a href={blogHref}>{t(lang, "footer.link.blog")}</a></li>
        <li><a href={rssHref} target="_blank" rel="noopener">{t(lang, "footer.link.rss")}</a></li>
        <li><a href={site.github} target="_blank" rel="noopener">{t(lang, "footer.link.github")}</a></li>
        <li><a href={release.releasePageUrl} target="_blank" rel="noopener">{t(lang, "footer.link.releases")}</a></li>
      </ul>
    </div>
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.legal")}</span>
      <ul>
        <li><a href="/impressum">{t(lang, "footer.link.imprint")}</a></li>
        <li><a href="/datenschutz">{t(lang, "footer.link.privacy")}</a></li>
      </ul>
    </div>
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.contact")}</span>
      <ul>
        <li><a href={`mailto:${site.contactEmail}`}>{t(lang, "footer.link.email")}</a></li>
      </ul>
    </div>
    <div class="v2-footer-meta">
      <span class="v2-footer-eyebrow">{t(lang, "footer.about.eyebrow")}</span>
      <p>{t(lang, "footer.about.body")}</p>
      <p class="v2-footer-version">
        v{release.version} · <span class="mac-only">{t(lang, "footer.about.os.mac")}</span><span class="win-only">{t(lang, "footer.about.os.win")}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Footer styling - identical to the definitions in landing.css,
     but scoped here so the footer also looks correct on pages
     without the global landing.css import (LegalShell). */
  .v2-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px dashed rgba(28, 24, 20, 0.10);
    color: rgba(28, 24, 20, 0.65);
    font-size: 12px;
  }
  .v2-footer-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 2fr;
    gap: 24px;
  }
  .v2-footer-h {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1c1814;
    margin-bottom: 10px;
  }
  .v2-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .v2-footer ul li { padding: 3px 0; }
  .v2-footer a {
    color: inherit;
    text-decoration: none;
  }
  .v2-footer a:hover { color: #1c1814; }
  .v2-footer-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1c1814;
    margin-bottom: 8px;
  }
  .v2-footer-meta p {
    margin: 0 0 6px;
    line-height: 1.55;
  }
  .v2-footer-version {
    color: rgba(28, 24, 20, 0.45);
  }

  /* Platform split - active default is macOS, Windows shows when
     data-platform="windows" is on <html> (see Base.astro). */
  .win-only { display: none; }
  :global([data-platform="windows"]) .mac-only { display: none; }
  :global([data-platform="windows"]) .win-only { display: revert; }

  @media (max-width: 880px) {
    .v2-footer-cols { grid-template-columns: 1fr 1fr; }
    .v2-footer-meta { grid-column: 1 / -1; }
  }
</style>
