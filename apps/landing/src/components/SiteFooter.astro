---
/**
 * SiteFooter - der eine Footer, den alle Seiten teilen.
 *
 * Wird sowohl von AppShell (Landing-Routen inkl. Blog) als auch von
 * LegalShell (Impressum, Datenschutz) eingebunden. Dadurch tauchen
 * Blog- und RSS-Link automatisch auf jeder Page auf, ohne dass man
 * jede Shell separat pflegen muss.
 *
 * Sprache:
 *  - AppShell reicht ihr `lang`-Prop durch (DE oder EN).
 *  - LegalShell ist rechtsbedingt DE-only und ruft den Footer mit
 *    `lang="de"` auf - der Toggle existiert auf Legal-Seiten nicht.
 *
 * Plattform-spezifische Versions-Zeile ("macOS 13+" vs "Windows 10+")
 * laeuft ueber die globalen `data-platform`-Attribute, die Base.astro
 * vor dem ersten Paint setzt. Die `.mac-only` / `.win-only`-Regeln
 * kommen aus landing.css fuer Landing-Pages und werden hier zusaetzlich
 * scoped definiert, damit der Footer auch auf Seiten ohne globalen
 * landing.css-Import (z.B. Legal) korrekt umschaltet.
 */
import { getLatestRelease, site } from "../data/site";
import { routePath, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const release = await getLatestRelease();

const blogHref = routePath(lang, "blog");
const rssHref = lang === "de" ? "/rss.xml" : "/en/rss.xml";
---

<footer class="v2-footer">
  <div class="v2-footer-cols">
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.project")}</span>
      <ul>
        <li><a href={blogHref}>{t(lang, "footer.link.blog")}</a></li>
        <li><a href={rssHref} target="_blank" rel="noopener">{t(lang, "footer.link.rss")}</a></li>
        <li><a href={site.github} target="_blank" rel="noopener">{t(lang, "footer.link.github")}</a></li>
        <li><a href={release.releasePageUrl} target="_blank" rel="noopener">{t(lang, "footer.link.releases")}</a></li>
      </ul>
    </div>
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.legal")}</span>
      <ul>
        <li><a href="/impressum">{t(lang, "footer.link.imprint")}</a></li>
        <li><a href="/datenschutz">{t(lang, "footer.link.privacy")}</a></li>
      </ul>
    </div>
    <div>
      <span class="v2-footer-h">{t(lang, "footer.col.contact")}</span>
      <ul>
        <li><a href={`mailto:${site.contactEmail}`}>{t(lang, "footer.link.email")}</a></li>
      </ul>
    </div>
    <div class="v2-footer-meta">
      <span class="v2-footer-eyebrow">{t(lang, "footer.about.eyebrow")}</span>
      <p>{t(lang, "footer.about.body")}</p>
      <p class="v2-footer-version">
        v{release.version} · <span class="mac-only">{t(lang, "footer.about.os.mac")}</span><span class="win-only">{t(lang, "footer.about.os.win")}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Footer-Styling - identisch zu den Definitionen in landing.css, hier
     aber scoped, damit der Footer auch auf Pages ohne globalen
     landing.css-Import (LegalShell) korrekt aussieht. */
  .v2-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px dashed rgba(28, 24, 20, 0.10);
    color: rgba(28, 24, 20, 0.65);
    font-size: 12px;
  }
  .v2-footer-cols {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 2fr;
    gap: 24px;
  }
  .v2-footer-h {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1c1814;
    margin-bottom: 10px;
  }
  .v2-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .v2-footer ul li { padding: 3px 0; }
  .v2-footer a {
    color: inherit;
    text-decoration: none;
  }
  .v2-footer a:hover { color: #1c1814; }
  .v2-footer-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1c1814;
    margin-bottom: 8px;
  }
  .v2-footer-meta p {
    margin: 0 0 6px;
    line-height: 1.55;
  }
  .v2-footer-version {
    color: rgba(28, 24, 20, 0.45);
  }

  /* Plattform-Split - aktiver Default ist macOS, Windows blendet ein,
     wenn data-platform="windows" auf <html> sitzt (siehe Base.astro). */
  .win-only { display: none; }
  :global([data-platform="windows"]) .mac-only { display: none; }
  :global([data-platform="windows"]) .win-only { display: revert; }

  @media (max-width: 880px) {
    .v2-footer-cols { grid-template-columns: 1fr 1fr; }
    .v2-footer-meta { grid-column: 1 / -1; }
  }
</style>
