---
interface Props {
  version: string;
}
const { version } = Astro.props;
---

<nav class="nav" aria-label="Hauptnavigation">
  <div class="container nav-inner">
    <a class="nav-brand" href="/" aria-label="Startseite">
      <img src="/img/icon.png" alt="" width="22" height="22" />
      <span>ScriptZ</span>
      <span class="ver">v{version}</span>
    </a>

    <div class="nav-links">
      <a href="/#fuer-wen">Für wen?</a>
      <a href="/#funktionen">Funktionen</a>
      <a href="/#vergleich">Vergleich</a>
      <a href="/#ueber-uns">Über uns</a>
      <a href="/#download" class="btn btn-primary btn-sm download-btn">Jetzt herunterladen</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .nav-brand img { border-radius: 5px; }
  .nav-brand .ver {
    color: var(--fg-faint);
    font-size: var(--fs-12);
    font-weight: 500;
    letter-spacing: 0;
    margin-left: -2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }
  .nav-links a {
    color: var(--fg-muted);
    font-size: var(--fs-14);
  }
  .nav-links a:hover { color: var(--fg); }

  /* Dunkler CTA-Button im Nav (V2-Mockup).
     Selektor bewusst spezifischer als ".nav-links a", sonst zieht
     der Muted-Color-Default oben den Textfarb-Wert wieder runter. */
  .nav-links a.download-btn,
  .nav-links a.download-btn:hover {
    background-color: #1c1814;
    color: #fff;
  }
  .nav-links a.download-btn:hover {
    background-color: #0f0d0a;
  }

  @media (max-width: 760px) {
    .nav-links a:not(.download-btn) { display: none; }
  }
  @media (max-width: 480px) {
    .nav-brand .ver { display: none; }
  }
</style>
