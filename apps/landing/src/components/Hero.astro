---
import type { ReleaseInfo } from "../data/site";

interface Props {
  release: ReleaseInfo;
}
const { release } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-left reveal">
      <span class="pill hero-pill">
        <span class="hero-pill-dot" aria-hidden="true"></span>
        Skripte schreiben. Klar strukturieren. Fokus behalten.
      </span>

      <h1 class="hero-title">
        Schreib Skripte.<br />
        <span class="hero-title-em">Nicht Overhead.</span>
      </h1>

      <p class="hero-lead">
        ScriptZ ist die lokale Skript-App, die wir bei AgentZ täglich
        für unsere eigenen Videos nutzen. Damit Ideen nicht in Tools
        verloren gehen, sondern als Skript bei dir landen.
      </p>

      <div class="hero-cta">
        <a href={release.dmgUrl} class="btn btn-primary btn-lg">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M16.7 13.5c-.02-2.34 1.91-3.46 2-3.51-1.09-1.6-2.79-1.81-3.39-1.83-1.45-.15-2.83.85-3.56.85-.74 0-1.87-.83-3.07-.81-1.58.02-3.04.92-3.85 2.34-1.64 2.85-.42 7.07 1.17 9.39.78 1.13 1.71 2.4 2.93 2.36 1.18-.05 1.62-.76 3.04-.76 1.42 0 1.82.76 3.06.74 1.27-.02 2.07-1.15 2.85-2.29.9-1.31 1.27-2.59 1.29-2.66-.03-.01-2.46-.94-2.49-3.72ZM14.5 6.6c.65-.79 1.09-1.89.97-2.99-.94.04-2.07.62-2.74 1.41-.6.7-1.13 1.82-.99 2.91 1.04.08 2.11-.53 2.76-1.33Z" />
          </svg>
          Für macOS laden
        </a>
        <a href="#workflow" class="btn btn-secondary btn-lg">
          Wie es funktioniert
        </a>
      </div>

      <p class="hero-meta">
        macOS 13 oder neuer · Apple Silicon &amp; Intel · v{release.version} ·
        <a href={release.releasePageUrl} class="hero-meta-link" rel="noopener noreferrer">Changelog</a>
      </p>
    </div>

    <ul class="hero-stats reveal" aria-label="Über AgentZ">
      <li class="hero-stat">
        <span class="hero-stat-num">240k+</span>
        <span class="hero-stat-label">Follower</span>
      </li>
      <li class="hero-stat hero-stat-em">
        <span class="hero-stat-pre">knapp</span>
        <span class="hero-stat-num">4.000</span>
        <span class="hero-stat-label">Videos</span>
      </li>
      <li class="hero-stat hero-stat-em">
        <span class="hero-stat-pre">fast</span>
        <span class="hero-stat-num">4 Jahre</span>
        <span class="hero-stat-label">Content-Alltag</span>
      </li>
      <li class="hero-stat">
        <span class="hero-stat-pre">gebaut von</span>
        <span class="hero-stat-num hero-stat-brand">AgentZ</span>
        <span class="hero-stat-label">aus Schwerin</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-10);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 720px;
    background:
      radial-gradient(circle at 30% 0%, rgba(28, 24, 20, 0.05), transparent 55%),
      radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.6), transparent 55%);
    z-index: 0;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--sp-10);
    align-items: end;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    max-width: 36rem;
  }

  .hero-pill {
    background: var(--bg-elev-1);
    border-color: var(--border);
    color: var(--fg-muted);
    align-self: flex-start;
  }
  .hero-pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 4px rgba(28, 24, 20, 0.10);
  }

  .hero-title {
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: var(--sp-2) 0 var(--sp-1);
  }
  .hero-title-em {
    color: var(--fg-muted);
  }

  .hero-lead {
    color: var(--fg-muted);
    font-size: var(--fs-18);
    line-height: var(--lh-relaxed);
    max-width: 44ch;
  }

  .hero-cta {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-2);
  }

  .hero-meta {
    color: var(--fg-faint);
    font-size: var(--fs-13);
    letter-spacing: 0.01em;
  }
  .hero-meta-link {
    color: var(--fg-muted);
    border-bottom: 1px solid transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .hero-meta-link:hover {
    color: var(--fg);
    border-bottom-color: var(--border-strong);
  }

  /* ---- Stats-Spalte ---- */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5) var(--sp-7);
    padding-bottom: var(--sp-5);
  }
  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero-stat-pre {
    font-size: var(--fs-12);
    color: var(--fg-faint);
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }
  .hero-stat-num {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--fg);
  }
  .hero-stat-brand {
    font-style: italic;
  }
  .hero-stat-label {
    font-size: var(--fs-13);
    color: var(--fg-muted);
    margin-top: 2px;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
      align-items: start;
    }
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-4);
      padding-bottom: 0;
    }
    .hero-stat-num { font-size: clamp(22px, 4.5vw, 28px); }
    .hero-stat-label { font-size: var(--fs-12); }
  }
  @media (max-width: 600px) {
    .hero { padding-top: var(--sp-9); }
    .hero-stats { grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
  }
</style>
