---
import AutoTypingDemo from "./AutoTypingDemo.astro";
import type { ReleaseInfo } from "../data/site";

interface Props {
  release: ReleaseInfo;
}
const { release } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <span class="pill hero-pill">
      <span class="hero-pill-dot" aria-hidden="true"></span>
      Endlich da: ScriptZ v{release.version} für macOS
    </span>

    <h1 class="h-display hero-title">
      Skripte schreiben,<br />
      <span class="hero-title-em">ohne dass dir die App im Weg steht.</span>
    </h1>

    <p class="lead hero-lead">
      ScriptZ ist die ruhige Werkstatt für Drehbücher, Sketches und
      TikTok-Skripte. Alles bleibt auf deinem Rechner. Keine Cloud,
      keine Pflicht-Anmeldung, keine Ablenkung. Immer kostenlos.
      Open Source.
    </p>

    <div class="hero-cta">
      <a href={release.dmgUrl} class="btn btn-primary btn-lg">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M12 3a1 1 0 0 1 1 1v9.59l3.3-3.3a1 1 0 1 1 1.4 1.42l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 1 1 1.4-1.42l3.3 3.3V4a1 1 0 0 1 1-1Z" />
          <path d="M5 19a1 1 0 0 1 1-1h12a1 1 0 1 1 0 2H6a1 1 0 0 1-1-1Z" />
        </svg>
        Für Mac laden
      </a>
      <a href="#warum" class="btn btn-secondary btn-lg">Warum ScriptZ?</a>
    </div>

    <p class="hero-meta">
      Apple Silicon · macOS 13+ · 100% lokal · MIT-Lizenz
    </p>
  </div>

  <div class="container hero-demo-wrap">
    <AutoTypingDemo />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-11);
    overflow: hidden;
  }

  /* Sehr dezenter Verlauf im Hintergrund - bewusst neutral, kein Akzent */
  .hero-bg {
    position: absolute;
    inset: -10% -10% auto -10%;
    height: 720px;
    background:
      radial-gradient(circle at 50% 0%, rgba(28, 24, 20, 0.06), transparent 55%),
      radial-gradient(circle at 80% 30%, rgba(255, 255, 255, 0.4), transparent 55%);
    z-index: 0;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
    padding-bottom: var(--sp-10);
  }

  .hero-pill {
    background: var(--bg-elev-1);
    border-color: var(--border);
    color: var(--fg-muted);
  }
  .hero-pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg);
    box-shadow: 0 0 0 4px rgba(28, 24, 20, 0.10);
  }

  .hero-title {
    margin-top: var(--sp-3);
    max-width: 18ch;
  }
  .hero-title-em {
    color: var(--fg-muted);
    font-weight: 700;
  }

  .hero-lead {
    margin: 0 auto;
    text-align: center;
  }

  .hero-cta {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--sp-3);
  }

  .hero-meta {
    color: var(--fg-faint);
    font-size: var(--fs-13);
    letter-spacing: 0.02em;
  }

  .hero-demo-wrap {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 720px) {
    .hero { padding-top: var(--sp-9); }
    .hero-inner { padding-bottom: var(--sp-8); gap: var(--sp-5); }
  }
</style>
