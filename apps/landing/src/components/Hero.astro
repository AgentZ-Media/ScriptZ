---
import type { ReleaseInfo } from "../data/site";

interface Props {
  release: ReleaseInfo;
}
const { release } = Astro.props;
---

<header id="top" class="hero">
  <div class="container">
    <span class="pill2">Der Skripteditor für Content Creator</span>

    <h1>Bessere Skripte. Bessere Videos.</h1>

    <p class="lead2">
      ScriptZ ist der minimalistische Skripteditor für TikTok,
      YouTube Shorts, Instagram &amp; Facebook Reels. Du schreibst -
      Format, Charaktere und Export passieren von allein.
    </p>

    <div class="cta2">
      <a class="btn btn-primary btn-lg" href={release.dmgUrl}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
        </svg>
        Kostenlos für macOS herunterladen
      </a>
      <span class="install2">macOS 13.0 oder neuer · v{release.version}</span>
    </div>

    <div class="feat-row">
      <span class="f">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
        Minimalistisch
      </span>
      <span class="f">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        Blitzschnell
      </span>
      <span class="f">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Für Creator gemacht
      </span>
      <span class="f">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Offline &amp; sicher
      </span>
    </div>

    <figure class="hero-shot reveal">
      <img src="/img/app/editor-highlights.png" alt="ScriptZ Editor mit Charakter-Highlights" loading="eager" />
    </figure>
  </div>
</header>

<style>
  .hero {
    padding: var(--sp-12) 0 var(--sp-9);
    text-align: center;
  }

  .pill2 {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 6px 14px;
    border-radius: var(--r-pill);
    background: #fff;
    border: 1px solid var(--border);
    font-size: var(--fs-13);
    color: var(--fg-muted);
  }

  .hero h1 {
    margin: var(--sp-6) auto 0;
    max-width: 18ch;
    font-size: clamp(40px, 5.6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .lead2 {
    margin: var(--sp-5) auto 0;
    max-width: 54ch;
    color: var(--fg-muted);
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.55;
  }

  .cta2 {
    margin: var(--sp-7) auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .install2 {
    font-size: var(--fs-12);
    color: var(--fg-subtle);
  }

  .feat-row {
    margin: var(--sp-9) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-9);
    font-size: var(--fs-13);
    color: var(--fg-muted);
  }
  .feat-row .f {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .feat-row .f svg {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }

  .hero-shot {
    margin: var(--sp-10) auto 0;
    max-width: 1080px;
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 720px) {
    .hero { padding: var(--sp-11) 0 var(--sp-8); }
    .feat-row { gap: var(--sp-5) var(--sp-7); margin-top: var(--sp-7); }
    .hero-shot { margin-top: var(--sp-8); }
  }
</style>
