---
const steps = [
  {
    n: "1",
    title: "Neues Skript erstellen",
    body: "Starte mit einem Klick. Leeres Blatt oder Vorlage - du entscheidest.",
  },
  {
    n: "2",
    title: "Schreiben & strukturieren",
    body: "Füge Charaktere, Dialoge und Notizen hinzu. ScriptZ macht den Rest.",
  },
  {
    n: "3",
    title: "Exportieren & umsetzen",
    body: "Dein Skript ist bereit. Kopieren, teilen oder direkt ins Video gehen.",
  },
];
---

<section class="steps" id="fuer-wen">
  <div class="container">
    <div class="steps-head">
      <span class="eyebrow">So einfach geht's</span>
      <h2 class="h-section">In 3 Schritten zum fertigen Skript.</h2>
    </div>

    <div class="steps-row">
      {steps.map((s) => (
        <div class="step">
          <div class="n">{s.n}</div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    padding: var(--sp-12) 0;
    background: var(--bg-elev-2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .steps-head {
    text-align: center;
    max-width: 38ch;
    margin: 0 auto var(--sp-10);
  }
  .steps-head h2 {
    margin-top: var(--sp-4);
  }

  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-7);
    position: relative;
  }
  @media (max-width: 760px) {
    .steps-row { grid-template-columns: 1fr; gap: var(--sp-9); }
  }
  .steps-row::before {
    content: "";
    position: absolute;
    left: 18%;
    right: 18%;
    top: 32px;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 12px);
    z-index: 0;
  }
  @media (max-width: 760px) {
    .steps-row::before { display: none; }
  }

  .step {
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .step .n {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 99px;
    background: #fff;
    border: 1px solid var(--border);
    font-size: var(--fs-18);
    font-weight: 700;
    color: var(--fg);
    margin-bottom: var(--sp-4);
  }
  .step h3 {
    font-size: var(--fs-16);
    letter-spacing: -0.01em;
  }
  .step p {
    margin-top: var(--sp-2);
    font-size: var(--fs-14);
    color: var(--fg-muted);
    line-height: 1.55;
    max-width: 32ch;
    margin-left: auto;
    margin-right: auto;
  }
</style>
