              <button class="v2-idea-trash" type="button" aria-label={t(lang, "ideas.btn.delete.aria")}>
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                </svg>
              </button>
            </div>
          </li>
        ))}
      </ul>

      <div class="v2-ideas-hint">
        <span class="v2-kbd-pill">⌘ I</span> {t(lang, "ideas.hint.before")}
      </div>
    </section>

    <!-- ============== Footer (immer sichtbar) =============== -->
    <footer class="v2-footer">
      <div class="v2-footer-cols">
        <div>
          <span class="v2-footer-h">{t(lang, "footer.col.project")}</span>
          <ul>
            <li><a href={site.github} target="_blank" rel="noopener">{t(lang, "footer.link.github")}</a></li>
            <li><a href={release.releasePageUrl} target="_blank" rel="noopener">{t(lang, "footer.link.releases")}</a></li>
          </ul>
        </div>
        <div>
          <span class="v2-footer-h">{t(lang, "footer.col.legal")}</span>
          <ul>
            <li><a href="/impressum">{t(lang, "footer.link.imprint")}</a></li>
            <li><a href="/datenschutz">{t(lang, "footer.link.privacy")}</a></li>
          </ul>
        </div>
        <div>
          <span class="v2-footer-h">{t(lang, "footer.col.contact")}</span>
          <ul>
            <li><a href={`mailto:${site.contactEmail}`}>{t(lang, "footer.link.email")}</a></li>
          </ul>
        </div>
        <div class="v2-footer-meta">
          <span class="v2-footer-eyebrow">{t(lang, "footer.about.eyebrow")}</span>
          <p>{t(lang, "footer.about.body")}</p>
          <p class="v2-footer-version">v{release.version} · <span class="mac-only">{t(lang, "footer.about.os.mac")}</span><span class="win-only">{t(lang, "footer.about.os.win")}</span></p>
        </div>
      </div>
    </footer>

  </main><!-- /paper -->

  <!-- SPRINT-PILLE
       Der Fortschrittsring wird per JS via stroke-dashoffset auf dem
       zweiten <circle> live aktualisiert. r=9 → Umfang 2*PI*9 ≈ 56.55.
       Initialer Text und Format-Strings kommen via data-Attribute aus
       dem i18n-Katalog, damit das Script lang-agnostisch bleibt. -->
  <div
    class="v2-sprint"
    id="sprint"
    data-label={jsStrings.sprintLabel}
    data-format={jsStrings.sprintFormat}
  >
    <span class="v2-sprint-ring">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" stroke-opacity="0.22"/>
        <circle
          class="v2-sprint-progress"
          cx="12" cy="12" r="9"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-dasharray="56.5487"
          stroke-dashoffset="56.5487"
          transform="rotate(-90 12 12)"
        />
      </svg>
    </span>
    <span class="v2-sprint-txt">{jsStrings.sprintLabel}</span>
  </div>
</div><!-- /v2-shell -->

<script is:inline define:vars={{ jsStrings }}>
  (function () {
    // ===== Plattform-CTA-Update =====================================
    // Base.astro setzt data-platform="windows|macos|linux" auf <html>
    // synchron im <head>, bevor dieser Body-Script laeuft. Wir lesen
    // den Wert hier ab und tauschen href + Label aller .js-platform-cta
    // Buttons aus. Default-Render war Mac-Variante (data-href-mac /
    // data-label-mac); auf Windows zieht .data-href-win / .data-label-win.
    var platform = document.documentElement.getAttribute('data-platform') || 'macos';
    var isWin = platform === 'windows';

    document.querySelectorAll('.js-platform-cta').forEach(function (el) {
      var hrefMac = el.getAttribute('data-href-mac');
      var hrefWin = el.getAttribute('data-href-win');
      var labelMac = el.getAttribute('data-label-mac');
      var labelWin = el.getAttribute('data-label-win');
      if (isWin && hrefWin) el.setAttribute('href', hrefWin);
      else if (hrefMac) el.setAttribute('href', hrefMac);
      var labelEl = el.querySelector('.js-platform-label');
      if (labelEl) labelEl.textContent = (isWin ? labelWin : labelMac) || labelEl.textContent;
    });

    // Download-Tab data-title plattform-spezifisch nachziehen, damit
    // der Toolbar-Title beim Klick die richtige Plattform-Variante
    // anzeigt.
    var dlTab = document.querySelector('.js-tab-download');
    if (dlTab) {
      var tMac = dlTab.getAttribute('data-title-mac');
      var tWin = dlTab.getAttribute('data-title-win');
      dlTab.setAttribute('data-title', (isWin ? tWin : tMac) || dlTab.getAttribute('data-title'));
    }

    // ===== Reaktive Tabs ==========================================
    // Jeder Knopf mit data-tab schaltet die Sichtbarkeit der
    // .v2-tab-content-Sektion mit passendem data-content.
    // data-tab="home" ist Sonderfall: scrollt zurueck zum Hero.
    var tabs = document.querySelectorAll('[data-tab]');
    var contents = document.querySelectorAll('.v2-tab-content');
    var toolbarTitle = document.getElementById('toolbar-title');

    var activate = function (id, opts) {
      opts = opts || {};
      if (id === 'home') {
        // Home scrollt zum Hero, aber laesst den aktiven Tab in Ruhe.
        document.documentElement.scrollIntoView({ behavior: 'smooth' });
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      var activeTab = null;
      document.querySelectorAll('.v2-titlebar [data-tab]').forEach(function (b) {
        var on = b.getAttribute('data-tab') === id;
        b.classList.toggle('is-active', on);
        if (on) activeTab = b;
      });

      contents.forEach(function (c) {
        c.classList.toggle('is-active', c.getAttribute('data-content') === id);
      });

      if (activeTab && toolbarTitle) {
        var title = activeTab.getAttribute('data-title');
        if (title) toolbarTitle.textContent = title;
      }

      if (opts.scroll !== false) {
        // Scroll-Position so anpassen, dass die App-Chrome oben sichtbar
        // bleibt. Wir scrollen zum oberen Rand der Chrome.
        var chrome = document.querySelector('.v2-chrome');
        if (chrome) {
          var rect = chrome.getBoundingClientRect();
          var top = window.scrollY + rect.top;
          window.scrollTo({ top: top, behavior: 'smooth' });
        }
      }
    };

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var id = t.getAttribute('data-tab');
        if (id) activate(id);
      });
    });

    // ===== Screenshot-Galerie =====================================
    var shotTabs = document.querySelectorAll('.v2-shot-tab');
    var shots = document.querySelectorAll('.v2-shot');
    shotTabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var id = t.getAttribute('data-shot');
        shotTabs.forEach(function (x) {
          var on = x === t;
          x.classList.toggle('is-active', on);
          x.setAttribute('aria-selected', String(on));
        });
        shots.forEach(function (s) {
          s.classList.toggle('is-active', s.getAttribute('data-shot') === id);
        });
      });
    });

    // ===== Copy-Button im Install-Hinweis =========================
    document.querySelectorAll('.v2-install-copy').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var cmd = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(cmd);
          btn.textContent = jsStrings.copied;
          btn.classList.add('is-done');
          setTimeout(function () {
            btn.textContent = jsStrings.copy;
            btn.classList.remove('is-done');
          }, 1600);
        } catch (e) {
          btn.textContent = jsStrings.copyManual;
          setTimeout(function () { btn.textContent = jsStrings.copy; }, 2000);
        }
      });
    });

    // ===== Sprint-Pille: Lese-Fortschritt =========================
    var sprintEl = document.getElementById('sprint');
    var sprintTxt = document.querySelector('.v2-sprint-txt');
    var sprintRing = document.querySelector('.v2-sprint-progress');
    var RING_CIRC = 56.5487; // 2 * PI * r mit r=9
    var paper = document.getElementById('paper');
    var sprintLabel = sprintEl ? sprintEl.getAttribute('data-label') || 'Sprint' : 'Sprint';
    var sprintFormat = sprintEl ? sprintEl.getAttribute('data-format') || '{r} / {t} W' : '{r} / {t} W';
    if (sprintTxt && paper) {
      var recount = function () {
        var active = document.querySelector('.v2-tab-content.is-active');
        var text = active ? active.textContent.trim() : '';
        var words = text ? text.split(/\s+/).length : 0;
        sprintTxt.dataset.total = String(words);
      };
      recount();
      // Recount bei Tab-Wechsel
      tabs.forEach(function (t) { t.addEventListener('click', function () { setTimeout(recount, 50); }); });

      var updateProgress = function () {
        var total = parseInt(sprintTxt.dataset.total || '0', 10);
        var top = window.scrollY;
        var max = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        var ratio = Math.min(Math.max(top / max, 0), 1);
        if (sprintRing) {
          sprintRing.setAttribute('stroke-dashoffset', String(RING_CIRC * (1 - ratio)));
        }
        if (total === 0) {
          sprintTxt.textContent = sprintLabel;
          return;
        }
        var read = Math.round(ratio * total);
        sprintTxt.textContent = sprintFormat.replace('{r}', String(read)).replace('{t}', String(total));
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
    }

    // ===== Sprach-Toggle: Auswahl persistieren ====================
    // Damit der Auto-Detect-Redirect (in Base.astro) nach einem
    // bewussten Wechsel den Nutzer in Ruhe laesst.
    document.querySelectorAll('[data-lang-set]').forEach(function (el) {
      el.addEventListener('click', function () {
        var target = el.getAttribute('data-lang-set');
        if (target) {
          try {
            localStorage.setItem('scriptz-lang', target);
          } catch (_) { /* private mode etc. */ }
        }
      });
    });
  })();
</script>
