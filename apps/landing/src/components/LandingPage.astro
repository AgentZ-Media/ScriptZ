---
/**
 * ScriptZ Landing - mehrsprachig + plattform-aware.
 *
 * Konzept: ein Hero oben (klassisches Landingpage-Pattern), darunter
 * eine eingebettete ScriptZ-App-Simulation. Tabs sind echte Tabs:
 * jeder Klick wechselt den Paper-Inhalt, kein Scrollen zu Sektionen.
 * Die Ideen-Ansicht ist ein 1:1-Nachbau der echten App.
 *
 * Block-Styling (CAPTION, CHARACTER, DIALOG, PARENTHETICAL, ACTION,
 * CAMERA, SFX) und Charakter-Highlighting (per-Zeile via
 * box-decoration-break) spiegeln Editor.css und highlight.ts der
 * Desktop-App.
 *
 * Sprache: kommt als `lang`-Prop rein. DE-Default wird unter `/`
 * gerendert, EN unter `/en`. Strings via `t(lang, key)` aus dem
 * i18n-Katalog. Toggle in der Titlebar wechselt zwischen den Routen.
 *
 * Plattform: wird clientside via Inline-Script in Base.astro detected
 * und auf `<html data-platform="...">` gesetzt. CSS-Klassen `.mac-only`
 * / `.win-only` blenden die jeweils nicht-passende Variante aus,
 * Buttons swappen `href` und Label aus `data-href-{mac,win}` /
 * `data-label-{mac,win}` Attributen. Default-Render ist macOS, damit
 * SEO + JS-aus-User die primaere Plattform sehen.
 */
import { getLatestRelease, site } from "../data/site";
import { t, switchLangPath, type Lang } from "../i18n";
import "../styles/landing.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const release = await getLatestRelease();

interface Idea {
  titleKey: Parameters<typeof t>[1];
  bodyKey?: Parameters<typeof t>[1];
  ageKey: Parameters<typeof t>[1];
  used?: boolean;
}

const openIdeas: Idea[] = [
  {
    titleKey: "ideas.sample.tutorial.title",
    bodyKey: "ideas.sample.tutorial.body",
    ageKey: "ideas.sample.tutorial.age",
  },
  {
    titleKey: "ideas.sample.fd.title",
    bodyKey: "ideas.sample.fd.body",
    ageKey: "ideas.sample.fd.age",
  },
  {
    titleKey: "ideas.sample.word.title",
    bodyKey: "ideas.sample.word.body",
    ageKey: "ideas.sample.word.age",
  },
  {
    titleKey: "ideas.sample.noai.title",
    bodyKey: "ideas.sample.noai.body",
    ageKey: "ideas.sample.noai.age",
  },
  {
    titleKey: "ideas.sample.reel.title",
    bodyKey: "ideas.sample.reel.body",
    ageKey: "ideas.sample.reel.age",
  },
  {
    titleKey: "ideas.sample.morning.title",
    bodyKey: "ideas.sample.morning.body",
    ageKey: "ideas.sample.morning.age",
  },
];

const usedIdeas: Idea[] = [
  {
    titleKey: "ideas.sample.cliche.title",
    ageKey: "ideas.sample.cliche.age",
    used: true,
  },
];

const allIdeas = [...openIdeas, ...usedIdeas];

const otherLang: Lang = lang === "de" ? "en" : "de";
const switchHref = switchLangPath(lang, otherLang, lang === "de" ? "/" : "/en");

// JS-seitige Strings als JSON ans Script weiterreichen.
const jsStrings = {
  copy: t(lang, "install.copy"),
  copied: t(lang, "install.copied"),
  copyManual: t(lang, "install.copyManual"),
  sprintLabel: t(lang, "sprint.label"),
  sprintFormat: lang === "de" ? "{r} / {t} W" : "{r} / {t} W",
  // Tab-Title-Strings fuer den Toolbar-Title. Plattform-gegated, damit
  // der Title beim Tab-Wechsel zur aktiven Plattform passt.
  tabTitles: {
    "warum": t(lang, "tab.warum.long"),
    "quickmodus": t(lang, "tab.quickmodus.long"),
    "no-ai": t(lang, "tab.noai.long"),
    "vergleich": t(lang, "tab.compare.long"),
    "download.mac": t(lang, "tab.download.long.mac"),
    "download.win": t(lang, "tab.download.long.win"),
  },
};
---

<!-- ============== HERO (bricht das Script-Frame) ============== -->
<section class="v2-hero">
  <div class="v2-hero-inner">
    <span class="v2-eyebrow">{t(lang, "hero.eyebrow")}</span>
    <h1 class="v2-h1">
      {t(lang, "hero.h1.line1")}<br/>
      {t(lang, "hero.h1.line2")}
    </h1>
    <p class="v2-lead">{t(lang, "hero.lead")}</p>
    <div class="v2-hero-cta">
      {/* Primaerer Download-Button: href + Label per JS aus data-attrs
          gesetzt, sobald die Plattform feststeht. Default ist macOS
          (dmg + Mac-Label) damit non-JS-User die Hauptplattform sehen. */}
      <a
        class="v2-btn v2-btn-primary v2-btn-lg js-platform-cta"
        href={release.dmgUrl}
        data-href-mac={release.dmgUrl}
        data-href-win={release.exeUrl}
        data-label-mac={t(lang, "hero.cta.download.mac")}
        data-label-win={t(lang, "hero.cta.download.win")}
      >
        <svg class="js-platform-icon-mac" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
        </svg>
        <svg class="js-platform-icon-win" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
        </svg>
        <span class="js-platform-label">{t(lang, "hero.cta.download.mac")}</span>
      </a>
      <a class="v2-btn v2-btn-ghost v2-btn-lg" href={site.github} target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2.01-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 2.91-.39c.99 0 1.98.13 2.91.39 2.22-1.5 3.2-1.18 3.2-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.2.67.8.55C20.71 21.38 24 17.07 24 12 24 5.65 18.85.5 12.5.5h-.5z"/>
        </svg>
        {t(lang, "hero.cta.github")}
      </a>
    </div>
    {/* Fallback-Link unter den CTA-Buttons fuer User auf "anderer"
        Plattform (Linux, oder Detection daneben). Immer sichtbar. */}
    <a class="v2-hero-fallback" href={release.releasePageUrl} target="_blank" rel="noopener">
      {t(lang, "hero.cta.allplatforms")}
    </a>
    <div class="v2-hero-meta">
      <span><b>v{release.version}</b> · <span class="mac-only">{t(lang, "hero.meta.os.mac")}</span><span class="win-only">{t(lang, "hero.meta.os.win")}</span></span>
      <span class="v2-meta-sep">·</span>
      <span>{t(lang, "hero.meta.zero")}</span>
    </div>

    <p class="v2-hero-web">
      {t(lang, "hero.web.intro")}{" "}
      <a href={site.webAppUrl} target="_blank" rel="noopener">
        {t(lang, "hero.web.link")}
      </a>
      <span class="v2-hero-web-hint">{t(lang, "hero.web.hint")}</span>
    </p>

    {/* macOS-Install-Hinweis: standardmaessig sichtbar, auf Windows
        per CSS ausgeblendet. */}
    <details class="v2-install v2-install-hero mac-only">
      <summary>
        <span class="v2-install-summary-text">{t(lang, "install.mac.summary")}</span>
        <span class="v2-install-chevron" aria-hidden="true">▾</span>
      </summary>
      <div class="v2-install-body">
        <p class="v2-install-text">{t(lang, "install.mac.body")}</p>
        <div class="v2-install-code">
          <code>xattr -cr /Applications/ScriptZ.app</code>
          <button class="v2-install-copy" type="button" data-copy="xattr -cr /Applications/ScriptZ.app">
            {t(lang, "install.copy")}
          </button>
        </div>
        <p class="v2-install-why">{t(lang, "install.mac.why")}</p>
      </div>
    </details>

    {/* Windows-Install-Hinweis: standardmaessig versteckt, auf Windows
        per CSS sichtbar. Statt Terminal-Befehl zwei Klick-Schritte. */}
    <details class="v2-install v2-install-hero win-only">
      <summary>
        <span class="v2-install-summary-text">{t(lang, "install.win.summary")}</span>
        <span class="v2-install-chevron" aria-hidden="true">▾</span>
      </summary>
      <div class="v2-install-body">
        <p class="v2-install-text">{t(lang, "install.win.body")}</p>
        <ol class="v2-install-steps">
          <li>{t(lang, "install.win.step1")}</li>
          <li>{t(lang, "install.win.step2")}</li>
        </ol>
        <p class="v2-install-why">{t(lang, "install.win.why")}</p>
      </div>
    </details>
  </div>
</section>

<!-- ============== APP-SHELL ================================== -->
<div class="v2-shell" data-theme="light">

  <!-- Chrome-Wrapper: titlebar + toolbar als sticky Einheit, damit
       kein Karo-Gap zwischen den beiden Bändern entsteht. -->
  <div class="v2-chrome">

    <!-- TAB-BAR -->
    <header class="v2-titlebar">
      <div class="v2-traffic" aria-hidden="true">
        <span class="dot dot-red"></span>
        <span class="dot dot-yellow"></span>
        <span class="dot dot-green"></span>
      </div>

      <div class="v2-tabs">
        <button class="v2-tab v2-tab-icon" type="button" data-tab="home" data-title={t(lang, "tab.home.title")} aria-label={t(lang, "tab.home.aria")}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
          </svg>
        </button>
        <button class="v2-tab v2-tab-icon" type="button" data-tab="ideen" data-title={t(lang, "tab.ideas.title")} aria-label={t(lang, "tab.ideas.aria")}>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 18h6"/><path d="M10 22h4"/>
            <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
          </svg>
          <span class="v2-tab-badge">{openIdeas.length}</span>
        </button>

        <button class="v2-tab v2-tab-script is-active" type="button" data-tab="warum" data-title={t(lang, "tab.warum.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.warum.short")}</span>
        </button>
        <button class="v2-tab v2-tab-script" type="button" data-tab="quickmodus" data-title={t(lang, "tab.quickmodus.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.quickmodus.short")}</span>
        </button>
        <button class="v2-tab v2-tab-script" type="button" data-tab="no-ai" data-title={t(lang, "tab.noai.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.noai.short")}</span>
        </button>
        <button class="v2-tab v2-tab-script" type="button" data-tab="vergleich" data-title={t(lang, "tab.compare.long")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.compare.short")}</span>
        </button>
        {/* Download-Tab: data-title gehoert zu Mac-Default, JS-Script
            tauscht ihn beim Plattform-Detect aus. */}
        <button class="v2-tab v2-tab-script js-tab-download" type="button" data-tab="download" data-title={t(lang, "tab.download.long.mac")} data-title-mac={t(lang, "tab.download.long.mac")} data-title-win={t(lang, "tab.download.long.win")}>
          <span class="v2-tab-ic">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          </span>
          <span class="v2-tab-title">{t(lang, "tab.download.short")}</span>
        </button>
      </div>

      <div class="v2-status">
        <div class="v2-lang" role="group" aria-label={t(lang, "lang.toggle.aria")}>
          {lang === "de" ? (
            <>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.de")}</span>
              <a class="v2-lang-pill" href={switchHref} hreflang="en" data-lang-set="en">{t(lang, "lang.toggle.en")}</a>
            </>
          ) : (
            <>
              <a class="v2-lang-pill" href={switchHref} hreflang="de" data-lang-set="de">{t(lang, "lang.toggle.de")}</a>
              <span class="v2-lang-pill is-active" aria-current="true">{t(lang, "lang.toggle.en")}</span>
            </>
          )}
        </div>
        <a class="v2-status-pill" href={site.github} target="_blank" rel="noopener">
          <span class="v2-dot v2-dot-on"></span>
          {t(lang, "status.opensource")}
        </a>
        <span class="v2-status-pill v2-status-saved">
          <span class="v2-dot v2-dot-on"></span>
          {t(lang, "status.saved")}
        </span>
      </div>
    </header>

    <!-- TOOLBAR -->
    <div class="v2-toolbar">
      <button class="v2-toolbar-back" type="button" data-tab="home" aria-label={t(lang, "toolbar.back.aria")}>
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {t(lang, "toolbar.back.label")}
      </button>
      <div class="v2-toolbar-title" id="toolbar-title">{t(lang, "tab.warum.long")}</div>
      <div class="v2-toolbar-pills">
        <span class="v2-pill is-active">{t(lang, "toolbar.pill.action")} <span class="v2-kbd">1</span></span>
        <span class="v2-pill">{t(lang, "toolbar.pill.character")} <span class="v2-kbd">2</span></span>
        <span class="v2-pill">{t(lang, "toolbar.pill.dialog")} <span class="v2-kbd">3</span></span>
        <span class="v2-pill v2-pill-more">…</span>
      </div>
      <div class="v2-toolbar-actions">
        <a
          class="v2-toolbar-btn js-platform-cta"
          href={release.dmgUrl}
          data-href-mac={release.dmgUrl}
          data-href-win={release.exeUrl}
        >
          <svg class="js-platform-icon-mac" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
          </svg>
          <svg class="js-platform-icon-win" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 5.49 10.5 4.5v7.49H3zm0 13.02L10.5 19.5v-7.49H3zm8.5-13.65L21 3.5v8.49h-9.5zm0 14.28L21 20.5v-8.49h-9.5z"/>
          </svg>
          {t(lang, "toolbar.download")}
        </a>
      </div>
    </div>

  </div><!-- /v2-chrome -->

  <!-- ============== PAPER (Tab-Content) ====================== -->
  <main class="v2-paper" id="paper">

    <!-- ===== TAB: WARUM ===== -->
    <section class="v2-tab-content is-active" data-content="warum" data-section-title={t(lang, "tab.warum.long")}>
      <div class="v2-block v2-caption">{t(lang, "warum.caption")}</div>

      <div class="v2-block v2-action">{t(lang, "warum.action1")}</div>

      <div class="v2-block v2-action">{t(lang, "warum.action2")}</div>

      <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
      <div class="v2-block v2-parenthetical" data-speaker="TIMO"><span class="v2-t">{t(lang, "warum.timo1.paren")}</span></div>
      <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "warum.timo1.dialog")}</span></div>

      <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
      <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "warum.axel1.dialog")}</span></div>

      <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
      <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "warum.timo2.dialog")}</span></div>

      <div class="v2-block v2-character" data-speaker="AXEL"><span class="v2-t">AXEL</span></div>
      <div class="v2-block v2-parenthetical" data-speaker="AXEL"><span class="v2-t">{t(lang, "warum.axel2.paren")}</span></div>
      <div class="v2-block v2-dialog" data-speaker="AXEL"><span class="v2-t">{t(lang, "warum.axel2.dialog")}</span></div>

      <div class="v2-block v2-character" data-speaker="TIMO"><span class="v2-t">TIMO</span></div>
      <div class="v2-block v2-dialog" data-speaker="TIMO"><span class="v2-t">{t(lang, "warum.timo3.dialog")}</span></div>

      <div class="v2-block v2-camera">{t(lang, "warum.cut")}</div>

      <div class="v2-block v2-action">{t(lang, "warum.action3")}</div>

      <div class="v2-shot-wrap">
        <div class="v2-shot-tabs" role="tablist">
          <button class="v2-shot-tab is-active" type="button" data-shot="overview" role="tab" aria-selected="true">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/>
            </svg>
            {t(lang, "shot.tab.overview")}
          </button>
          <button class="v2-shot-tab" type="button" data-shot="ideas" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18h6"/><path d="M10 22h4"/>
              <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2V18h6v-1.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>
            </svg>
            {t(lang, "shot.tab.ideas")}
          </button>
          <button class="v2-shot-tab" type="button" data-shot="editor" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
            </svg>
            {t(lang, "shot.tab.editor")}
          </button>
        </div>
        <div class="v2-shot-frame">
