---
// Wir-Bar — eigene Referenz / Social Proof von AgentZ.
// Keine Personenfotos, keine externen Logos.
---

<section class="wirbar" id="ueber-uns" aria-labelledby="wirbar-title">
  <div class="container">
    <div class="wirbar-grid">
      <div class="wirbar-lede">
        <strong id="wirbar-title">Wir haben ScriptZ für uns gebaut.</strong>
        <span>
          Als AgentZ schreiben wir seit fast 4 Jahren Skripte für TikTok,
          YouTube und Instagram. Kein Tool kam mit. Also haben wir eins
          gebaut.
        </span>
      </div>
      <div class="wirbar-stat">
        <div class="num">240K+</div>
        <div class="lbl">Follower über alle Plattformen</div>
      </div>
      <div class="wirbar-stat">
        <div class="num">4.000+</div>
        <div class="lbl">Videos in den letzten 4 Jahren</div>
      </div>
      <div class="wirbar-tag">
        <div class="ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
        </div>
        <div>
          Tausende Videos. Unzählige Skripte.<br />
          <strong>Eine Lösung: ScriptZ.</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wirbar {
    padding: var(--sp-10) 0;
    background: var(--bg-elev-2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .wirbar-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: var(--sp-9);
    align-items: center;
  }
  @media (max-width: 980px) {
    .wirbar-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-7); }
  }
  @media (max-width: 560px) {
    .wirbar-grid { grid-template-columns: 1fr; }
  }

  .wirbar-lede {
    font-size: var(--fs-15);
    line-height: 1.55;
  }
  .wirbar-lede strong {
    display: block;
    font-size: var(--fs-16);
    color: var(--fg);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }
  .wirbar-lede span {
    color: var(--fg-muted);
  }

  .wirbar-stat .num {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--fg);
  }
  .wirbar-stat .lbl {
    margin-top: 6px;
    font-size: var(--fs-13);
    color: var(--fg-muted);
  }

  .wirbar-tag {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    font-size: var(--fs-13);
    color: var(--fg-muted);
    line-height: 1.5;
  }
  .wirbar-tag strong { color: var(--fg); }
  .wirbar-tag .ic {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .wirbar-tag .ic svg {
    width: 18px;
    height: 18px;
  }
</style>
