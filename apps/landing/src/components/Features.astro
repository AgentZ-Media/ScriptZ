---
// 6-Card Feature-Grid (V2-Stil).
const features = [
  {
    title: "Fokus aufs Schreiben",
    body: "Keine Ablenkung, kein Schnickschnack. Nur du, deine Gedanken und ein leeres Skript.",
    svg: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/>',
  },
  {
    title: "Automatisch formatiert",
    body: "Charaktere, Zeilen, Seiten - ScriptZ übernimmt das für dich. Charakter-Farben sind im PDF wie im Editor.",
    svg: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  },
  {
    title: "Streak + Tagesziel",
    body: "Heatmap zeigt jeden Schreibtag des Jahres. Streak und Tagesziel halten dich im Flow - ganz ohne Push-Benachrichtigung.",
    svg: '<rect x="3" y="4" width="4" height="4" rx="1"/><rect x="9" y="4" width="4" height="4" rx="1"/><rect x="15" y="4" width="4" height="4" rx="1"/><rect x="3" y="10" width="4" height="4" rx="1"/><rect x="9" y="10" width="4" height="4" rx="1"/><rect x="15" y="10" width="4" height="4" rx="1"/><rect x="3" y="16" width="4" height="4" rx="1"/><rect x="9" y="16" width="4" height="4" rx="1"/><rect x="15" y="16" width="4" height="4" rx="1"/>',
  },
  {
    title: "Sprint-Timer eingebaut",
    body: "5, 15 oder 25 Minuten Pomodoro fürs Schreiben - direkt unten im Editor, mit Wort-Tracking.",
    svg: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M9 2h6"/>',
  },
  {
    title: "Ideen-Inbox",
    body: "⌘I aus jeder Ansicht. Idee rein, Enter, weitermachen. Später per Klick zum fertigen Skript - mit Notizen schon im ersten Block.",
    svg: '<path d="M9 21h6"/><path d="M12 17v4"/><path d="M12 3a6 6 0 0 0-3.3 11.02c.5.34.8.92.8 1.53V17h5v-1.45c0-.61.3-1.19.8-1.53A6 6 0 0 0 12 3z"/>',
  },
  {
    title: "Für kurze Videos gemacht",
    body: "Speziell für TikTok, Shorts, Reels &amp; Co. Entwickelt von Creator für Creator.",
    svg: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  },
];
---

<section class="feat4" id="funktionen">
  <div class="container">
    <div class="feat4-head">
      <span class="eyebrow">Weniger Aufwand. Mehr Output.</span>
      <h2 class="h-section">Schreiben, statt formatieren.</h2>
    </div>

    <div class="feat4-grid">
      {features.map((f) => (
        <article class="feat4-card">
          <div class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={f.svg} />
          </div>
          <h3>{f.title}</h3>
          <p set:html={f.body} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feat4 {
    padding: var(--sp-12) 0;
  }
  .feat4-head {
    text-align: center;
    max-width: 38ch;
    margin: 0 auto var(--sp-9);
  }
  .feat4-head h2 {
    margin-top: var(--sp-4);
  }
  .feat4-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  @media (max-width: 980px) {
    .feat4-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .feat4-grid { grid-template-columns: 1fr; }
  }

  .feat4-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-5);
    padding: var(--sp-7);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    transition: transform var(--t-med), border-color var(--t-med), box-shadow var(--t-med);
    min-height: 240px;
  }
  .feat4-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
  }
  .feat4-card .ic {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .feat4-card .ic svg {
    width: 20px;
    height: 20px;
  }
  .feat4-card h3 {
    font-size: var(--fs-18);
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .feat4-card p {
    font-size: var(--fs-14);
    color: var(--fg-muted);
    line-height: 1.55;
  }
</style>
