---
import type { ReleaseInfo } from "../data/site";

interface Props {
  release: ReleaseInfo;
}
const { release } = Astro.props;
---

<section class="download" id="download">
  <div class="container">
    <div class="cta2-card">
      <span class="pill pill-strong">
        <span class="dot dot-live" aria-hidden="true"></span>
        Aktuell: v{release.version} - macOS
      </span>
      <h2>Bereit für bessere Skripte?</h2>
      <p class="lead">
        Lade ScriptZ und schreib dein nächstes Skript in fünf Minuten ab jetzt.
      </p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href={release.dmgUrl}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 13.31c-.02-2.53 2.06-3.74 2.16-3.8-1.18-1.72-3.02-1.96-3.67-1.99-1.56-.16-3.05.92-3.84.92-.81 0-2.02-.9-3.32-.87-1.71.03-3.29 1-4.17 2.52-1.78 3.09-.45 7.65 1.28 10.16.85 1.23 1.85 2.61 3.16 2.56 1.27-.05 1.75-.82 3.28-.82 1.52 0 1.96.82 3.3.79 1.36-.02 2.22-1.25 3.05-2.49.97-1.43 1.36-2.83 1.38-2.9-.03-.01-2.64-1.01-2.61-4.08zM14.71 5.49c.7-.85 1.18-2.03 1.04-3.21-1.01.04-2.24.67-2.97 1.51-.65.74-1.22 1.94-1.07 3.1 1.13.09 2.29-.57 3-1.4z"/>
          </svg>
          Kostenlos für macOS herunterladen
        </a>
        <span class="install2">
          macOS 13.0 oder neuer - keine Anmeldung, kein Tracking, lokal &amp; offline
        </span>
      </div>

      <details class="firstrun">
        <summary>
          <span class="firstrun-q">Beim ersten Öffnen blockiert macOS die App?</span>
          <span class="firstrun-chevron" aria-hidden="true">▾</span>
        </summary>
        <div class="firstrun-body">
          <p>
            Das ist normal - ScriptZ ist Open Source und nicht bei Apple
            registriert. Einmal diesen Befehl im Terminal ausführen, danach
            läuft alles normal:
          </p>
          <div class="firstrun-cmd">
            <code id="firstrun-code">xattr -cr /Applications/ScriptZ.app</code>
            <button
              type="button"
              class="firstrun-copy"
              data-copy-target="firstrun-code"
              aria-label="Befehl kopieren"
            >
              <span class="firstrun-copy-label">Kopieren</span>
            </button>
          </div>
          <p class="firstrun-why">
            Warum? Apple verlangt eine kostenpflichtige Signatur, die diesen
            Schritt überflüssig machen würde. Bis sich das lohnt, ist der
            kurze Befehl der Preis dafür, dass ScriptZ kostenlos und ohne
            Konto bleibt.
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll(".firstrun-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-copy-target");
      const el = id ? document.getElementById(id) : null;
      if (!el) return;
      const text = el.textContent || "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand("copy");
        sel?.removeAllRanges();
      }
      const label = btn.querySelector(".firstrun-copy-label");
      if (!label) return;
      const prev = label.textContent;
      label.textContent = "Kopiert";
      btn.classList.add("is-copied");
      setTimeout(() => {
        label.textContent = prev;
        btn.classList.remove("is-copied");
      }, 1600);
    });
  });
</script>

<style>
  .download {
    padding: var(--sp-12) 0;
  }
  .cta2-card {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }
  .cta2-card h2 {
    margin-top: var(--sp-5);
    font-size: clamp(32px, 4.4vw, 48px);
    letter-spacing: -0.025em;
  }
  .cta2-card .lead {
    margin: var(--sp-5) auto 0;
  }
  .cta2-card .actions {
    margin-top: var(--sp-7);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .install2 {
    font-size: var(--fs-12);
    color: var(--fg-subtle);
  }

  .firstrun {
    margin: var(--sp-8) auto 0;
    max-width: 560px;
    text-align: left;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.6);
  }
  .firstrun summary {
    list-style: none;
    cursor: pointer;
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    font-size: var(--fs-14);
    color: var(--fg);
  }
  .firstrun summary::-webkit-details-marker {
    display: none;
  }
  .firstrun-q {
    font-weight: 500;
  }
  .firstrun-chevron {
    color: var(--fg-muted);
    transition: transform 160ms ease;
    font-size: 12px;
  }
  .firstrun[open] .firstrun-chevron {
    transform: rotate(180deg);
  }
  .firstrun-body {
    padding: 0 var(--sp-5) var(--sp-5);
    border-top: 1px dashed var(--border);
    padding-top: var(--sp-4);
    font-size: var(--fs-14);
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .firstrun-body p {
    margin: 0;
  }
  .firstrun-cmd {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: var(--sp-4) 0;
    padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-3);
    background: var(--bg-elev-3);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .firstrun-cmd code {
    flex: 1;
    font-size: var(--fs-13);
    color: var(--fg);
    overflow-x: auto;
    white-space: nowrap;
    background: none;
    padding: 0;
  }
  .firstrun-copy {
    flex: none;
    font: inherit;
    font-size: var(--fs-12);
    font-family: var(--font-sans, inherit);
    background: var(--fg);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    cursor: pointer;
    transition: background 120ms ease;
  }
  .firstrun-copy:hover {
    background: #000;
  }
  .firstrun-copy.is-copied {
    background: #22a06b;
  }
  .firstrun-why {
    margin-top: var(--sp-3) !important;
    font-size: var(--fs-12);
    color: var(--fg-subtle);
  }

  /* Pill mit aktiver Version */
  .pill-strong {
    background: #fff;
    border-color: var(--border-strong);
    color: var(--fg);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--fg);
    display: inline-block;
  }
  .dot-live {
    background: #22a06b;
    box-shadow: 0 0 0 4px rgba(34, 160, 107, 0.18);
  }
</style>
