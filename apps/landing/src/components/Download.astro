---
import { site, type ReleaseInfo } from "../data/site";

interface Props {
  release: ReleaseInfo;
}
const { release } = Astro.props;

let publishedDe = "";
if (release.publishedAt) {
  try {
    const d = new Date(release.publishedAt);
    publishedDe = new Intl.DateTimeFormat("de-DE", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    }).format(d);
  } catch {
    publishedDe = "";
  }
}
---

<section class="dl section" id="download">
  <div class="container-narrow">
    <div class="dl-card reveal">
      <span class="eyebrow">Hol's dir</span>
      <h2 class="h-section dl-title">
        Dein Workflow verdient ein besseres Skript-Tool.
      </h2>
      <p class="dl-lead">
        Eine Datei, ein Doppelklick, los geht's. Kostenlos für jeden
        Mac mit Apple-Silicon- oder Intel-Chip.
      </p>

      <div class="dl-cta">
        <a href={release.dmgUrl} class="btn btn-primary btn-lg dl-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M16.7 13.5c-.02-2.34 1.91-3.46 2-3.51-1.09-1.6-2.79-1.81-3.39-1.83-1.45-.15-2.83.85-3.56.85-.74 0-1.87-.83-3.07-.81-1.58.02-3.04.92-3.85 2.34-1.64 2.85-.42 7.07 1.17 9.39.78 1.13 1.71 2.4 2.93 2.36 1.18-.05 1.62-.76 3.04-.76 1.42 0 1.82.76 3.06.74 1.27-.02 2.07-1.15 2.85-2.29.9-1.31 1.27-2.59 1.29-2.66-.03-.01-2.46-.94-2.49-3.72ZM14.5 6.6c.65-.79 1.09-1.89.97-2.99-.94.04-2.07.62-2.74 1.41-.6.7-1.13 1.82-.99 2.91 1.04.08 2.11-.53 2.76-1.33Z" />
          </svg>
          ScriptZ {release.tag} laden
        </a>
        <p class="dl-meta">
          macOS 13 oder neuer · Universelle{" "}
          <code>.dmg</code>-Datei
          {publishedDe && (
            <>
              {" · "}veröffentlicht am {publishedDe}
            </>
          )}
        </p>
      </div>

      <div class="dl-firstrun">
        <h3 class="dl-firstrun-title">Beim ersten Start</h3>
        <ol class="dl-firstrun-list">
          <li>DMG öffnen, ScriptZ in den Programme-Ordner ziehen.</li>
          <li>
            Einmalig im Terminal:
            <code>xattr -cr /Applications/ScriptZ.app</code>
          </li>
          <li>App öffnen. Fertig. Updates kommen automatisch.</li>
        </ol>
        <p class="dl-firstrun-why">
          Schritt 2 ist nötig, weil wir keinen 99-Euro-Apple-Developer-
          Account haben. Genau deshalb kostet die App auch nichts.
        </p>
      </div>

      <div class="dl-alt">
        <a href={site.releasesPage} class="dl-alt-link" rel="noopener noreferrer">
          Ältere Versionen oder andere Architekturen → GitHub Releases
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .dl-card {
    background:
      radial-gradient(at 50% 0%, rgba(255, 255, 255, 0.6), transparent 60%),
      var(--bg-elev-1);
    border: 1px solid var(--border);
    border-radius: var(--r-6);
    padding: var(--sp-10) var(--sp-9);
    text-align: center;
    box-shadow: var(--shadow-card);
  }
  .dl-title {
    margin: var(--sp-3) 0 var(--sp-4);
    max-width: 22ch;
    margin-left: auto;
    margin-right: auto;
  }
  .dl-lead {
    color: var(--fg-muted);
    font-size: var(--fs-18);
    line-height: var(--lh-relaxed);
    max-width: 50ch;
    margin: 0 auto var(--sp-7);
  }

  .dl-cta {
    margin-bottom: var(--sp-8);
  }
  .dl-btn {
    margin-bottom: var(--sp-3);
  }
  .dl-meta {
    font-size: var(--fs-13);
    color: var(--fg-subtle);
  }
  .dl-meta code {
    background: var(--bg-elev-3);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: var(--fs-12);
  }

  .dl-firstrun {
    text-align: left;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--r-5);
    padding: var(--sp-6);
    max-width: 480px;
    margin: 0 auto;
  }
  .dl-firstrun-title {
    margin: 0 0 var(--sp-3);
    font-size: var(--fs-14);
    font-weight: 700;
    color: var(--fg);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .dl-firstrun-list {
    list-style: decimal inside;
    padding-left: 0;
    color: var(--fg-muted);
    font-size: var(--fs-14);
    line-height: 1.7;
  }
  .dl-firstrun-list li + li {
    margin-top: var(--sp-2);
  }
  .dl-firstrun-list code {
    display: inline-block;
    background: var(--bg-elev-3);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: var(--fs-13);
    color: var(--fg);
    margin-top: 4px;
    user-select: all;
  }
  .dl-firstrun-why {
    margin-top: var(--sp-4);
    font-size: var(--fs-12);
    color: var(--fg-faint);
    line-height: 1.6;
  }

  .dl-alt {
    margin-top: var(--sp-6);
  }
  .dl-alt-link {
    color: var(--fg-subtle);
    font-size: var(--fs-13);
    border-bottom: 1px solid transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .dl-alt-link:hover {
    color: var(--fg);
    border-bottom-color: var(--border-strong);
  }

  @media (max-width: 720px) {
    .dl-card { padding: var(--sp-8) var(--sp-5); }
  }
</style>
