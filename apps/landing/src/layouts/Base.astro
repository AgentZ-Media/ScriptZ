---
import "../styles/global.css";
import { getLatestRelease, site } from "../data/site";
import { type Lang, t } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  /** Wird im <title> dem Site-Namen vorangestellt. */
  pageTitle?: string;
  /**
   * Sprache der Seite. Default `de`. Legal-Seiten (Impressum,
   * Datenschutz) bleiben bei `de`, weil das deutsche Recht das
   * vorgibt - der Auto-Detect-Redirect ignoriert diese Pfade.
   */
  lang?: Lang;
}

const {
  title,
  description,
  pageTitle,
  lang = "de",
} = Astro.props;

const finalDescription = description ?? site.description;
const fullTitle =
  title ?? (pageTitle ? `${pageTitle} - ${site.name}` : `${site.name} - ${t(lang, "meta.title")}`);
const ogImage = `${site.url}/img/icon-large.png`;
const ogLocale = t(lang, "meta.ogLocale");
const htmlLang = lang === "en" ? "en" : "de";

// Canonical und hreflang. Die Landing existiert in DE (default, /) und
// EN (/en). Legal-Seiten existieren nur in DE - dann ist `enHref` null
// und wir setzen kein hreflang-en.
// `build.format: "file"` haengt an Pfaden ein `.html` an - auf
// `Astro.url.pathname` kann also `/impressum.html` ankommen statt
// `/impressum`. Wir normalisieren hier einmal, damit alle Vergleiche
// (isLegal, isHome, deHref) das gleiche Schema sehen.
const rawPath = Astro.url.pathname;
const currentPath = (() => {
  let p = rawPath.replace(/\.html$/, "").replace(/\/$/, "");
  // `/index` -> `/`, `/en/index` -> `/en` etc.
  p = p.replace(/\/index$/, "");
  return p || "/";
})();
const isLegal = currentPath === "/impressum" || currentPath === "/datenschutz";
const isHome = currentPath === "/" || currentPath === "/en";
const deHref = (() => {
  if (isLegal) return new URL(currentPath, site.url).toString();
  return new URL("/", site.url).toString();
})();
const enHref = isLegal ? null : new URL("/en", site.url).toString();
const canonical = lang === "en" ? enHref ?? deHref : deHref;

// Structured Data (JSON-LD): hilft Suchmaschinen, ScriptZ als Software
// und AgentZ Media als Publisher zu erkennen. `Organization` liegt auf
// jeder Seite, `SoftwareApplication` nur auf den Home-Routen (`/`, `/en`).
// Version + Download-Links kommen zur Build-Zeit aus der GitHub-Releases-
// API (`getLatestRelease`), fail-soft auf `fallbackVersion`.
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AgentZ Media",
  url: site.url,
  email: site.contactEmail,
  sameAs: [site.github],
  logo: `${site.url}/img/icon-large.png`,
};

let softwareLd: Record<string, unknown> | null = null;
if (isHome) {
  const release = await getLatestRelease();
  softwareLd = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    url: canonical,
    description: finalDescription,
    applicationCategory: "MultimediaApplication",
    operatingSystem: "macOS 13+, Windows 10+",
    softwareVersion: release.version,
    downloadUrl: release.releasePageUrl,
    image: ogImage,
    inLanguage: lang === "en" ? "en" : "de",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "EUR",
    },
    publisher: {
      "@type": "Organization",
      name: "AgentZ Media",
      url: site.url,
    },
  };
}
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={finalDescription} />

    <link rel="icon" type="image/png" href="/img/icon.png" />
    <link rel="apple-touch-icon" href="/img/icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: signalisiert Google die jeweils andere Sprachvariante.
         `x-default` zeigt auf die deutsche Variante, weil das die Default-
         Sprache der Site ist. -->
    <link rel="alternate" hreflang="de" href={deHref} />
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    <link rel="alternate" hreflang="x-default" href={deHref} />

    <link rel="preload" href="/fonts/iAWriterQuattroS-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/iAWriterQuattroS-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {softwareLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareLd)} />}

    <!-- Plattform-Auto-Detect: laeuft synchron vor dem ersten Paint
         und setzt `<html data-platform="windows|macos|linux">`. CSS-
         Regeln im landing.css (`.mac-only` / `.win-only`) blenden die
         passende Plattform-Variante ein. Default im Markup ist macOS,
         deshalb muessen wir nur bei Windows/Linux umschalten - der
         Mac-Pfad braucht kein Attribut.
         Bevorzugt wird `navigator.userAgentData.platform` (Client Hints,
         modern, expliziter String), fallback `navigator.userAgent`-Regex
         (deckt aelteres Firefox + Safari ab). Bei Unsicherheit bleiben
         wir bei macOS. -->
    <script is:inline>
      (function () {
        try {
          var p = "";
          var uad = navigator.userAgentData;
          if (uad && uad.platform) {
            p = String(uad.platform).toLowerCase();
          } else {
            var ua = (navigator.userAgent || "").toLowerCase();
            if (ua.indexOf("win") !== -1) p = "windows";
            else if (ua.indexOf("mac") !== -1 || ua.indexOf("iphone") !== -1 || ua.indexOf("ipad") !== -1) p = "macos";
            else if (ua.indexOf("linux") !== -1 || ua.indexOf("android") !== -1) p = "linux";
          }
          var resolved = "macos";
          if (p.indexOf("win") === 0 || p === "windows") resolved = "windows";
          else if (p.indexOf("mac") === 0 || p === "macos" || p === "ios") resolved = "macos";
          else if (p.indexOf("linux") === 0 || p === "android") resolved = "linux";
          document.documentElement.setAttribute("data-platform", resolved);
        } catch (_) {
          document.documentElement.setAttribute("data-platform", "macos");
        }
      })();
    </script>

    <!-- Sprach-Auto-Detect: laeuft bevor das Reveal-Script greift,
         damit der Redirect noch vor dem ersten Paint passieren kann.
         Regeln:
           1. Wenn der Nutzer bereits eine Wahl getroffen hat
              (localStorage["scriptz-lang"]), nie automatisch umleiten.
           2. Auf Legal-Seiten nie umleiten - die existieren nur in DE.
           3. Sonst: navigator.language anschauen. Beginnt sie mit "de",
              passt die deutsche Seite, kein Redirect noetig. Sonst -
              wenn wir auf "/" sind - einmalig nach "/en" umleiten.
           4. Niemals von /en nach / zurueck-redirecten, selbst wenn die
              Browser-Sprache "de" ist - der Nutzer koennte den Link
              bewusst geteilt haben. Nur die explizite Toggle-Wahl
              entscheidet dauerhaft. -->
    <script is:inline>
      (function() {
        try {
          var path = location.pathname;
          if (path === "/impressum" || path === "/datenschutz") return;
          if (localStorage.getItem("scriptz-lang")) return;
          var browserLang = (navigator.language || "de").slice(0, 2).toLowerCase();
          var onEn = path === "/en" || path.indexOf("/en/") === 0;
          if (browserLang !== "de" && !onEn) {
            location.replace("/en");
          }
        } catch (_) { /* private mode etc. */ }
      })();
    </script>
  </head>
  <body data-lang={lang}>
    <slot />

    <script>
      // Mikroanimationen: Reveal-on-scroll für Elemente mit .reveal.
      // Wir benutzen IntersectionObserver, damit die Page auch ohne JS
      // funktioniert (Reveal-Klasse zeigt dann einfach gar nicht).
      const reveal = (entries: IntersectionObserverEntry[]) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          }
        }
      };
      const observer = new IntersectionObserver(reveal, {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px",
      });
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
